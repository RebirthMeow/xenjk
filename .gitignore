#############
## Local scratch
#############
# Personal exploratory work — not part of the published mod.
old_other/

#=============================================================================
# xenjk-specific additions
#=============================================================================

# JKA install (4+ GB of game data + your local DLL/exe deploys -- belongs
# on disk only, never in version control)
/game_directory/

# Build script output paths (rebuilt every run, also live in
# %LOCALAPPDATA%\xenjk_build by default which is outside the repo anyway)
/build/
/build_check/
/build_test_fresh/
/install/

# Compiled artifacts (the build script copies these to GameData; not in repo)
*.dll
*.exe
*.pdb
*.ilk

# Override pk3 (regenerable from sources via build script -- don't commit
# the 30 MB binary)
*.pk3

# Scratch files left by dev sessions probing weird filesystem behavior
build_test_size.bin
grow_test.bin
codemp/cgame/cg_xcvar.h.bak2
codemp/cgame/grow_test.txt
codemp/cgame/test_write.txt

# IDE caches
.vs/
.vscode/

#############
## Local research and agent state
#############
# Evidence, builds and campaign worlds stay on disk, never in Git
# (AGENTS.md: retain local captures and manifests).
/.codex-research/
/.codex-archive/
/.codex-trash/
# Agent worktrees and per-user agent settings.
/.claude/worktrees/
/.claude/settings.local.json
__pycache__/

# Stray output from local runs
/navmesh_crash.log
/newmoduserdata
/--help

# The publish scrubber lists the private text it removes, so it stays local.
/tools/publish_scrub.py
