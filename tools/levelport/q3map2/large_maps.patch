 /*
+   CompactPlanes() (xenjk)
+   keeps only the planes a brush side or node uses, in their original order: q3map2 stores every plane with its
+   flipped twin, and collision-only maps reference about half of them (Kabuki map-23: 1.25 M of 2.30 M); the engine
+   never reads planeNum ^ 1 from the file. Keeps a district-sized BSP under the format's 2 GB.
+ */
+
+static void CompactPlanes(){
+	std::vector<int> remap( bspPlanes.size(), -1 );
+	for ( const bspBrushSide_t& side : bspBrushSides )
+		remap[ side.planeNum ] = 0;
+	for ( const bspNode_t& node : bspNodes )
+		remap[ node.planeNum ] = 0;
+	std::vector<bspPlane_t> kept;
+	for ( size_t i = 0; i < bspPlanes.size(); ++i )
+	{
+		if ( remap[ i ] == 0 ) {
+			remap[ i ] = kept.size();
+			kept.push_back( bspPlanes[ i ] );
+		}
+	}
+	for ( bspBrushSide_t& side : bspBrushSides )
+		side.planeNum = remap[ side.planeNum ];
+	for ( bspNode_t& node : bspNodes )
+		node.planeNum = remap[ node.planeNum ];
+	Sys_FPrintf( SYS_VRB, "%9zu BSP planes used of %zu\n", kept.size(), bspPlanes.size() );
+	bspPlanes.swap( kept );
+}
+
+
