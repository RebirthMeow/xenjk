+			  || vec[1] == -1 || vec[1] == 1 || ( vec[1] == 0 && vec[2] == 0 )
+			  || vec[2] == -1 || vec[2] == 1 || ( vec[2] == 0 && vec[0] == 0 ) ) {
+				continue; // axial, only test non-axial edges
+			}
+			for ( int axis = 0; axis < 3; ++axis ) {
+				for ( int dir = -1; dir <= 1; dir += 2 ) {
+					Vector3 vec2( 0 );
+					vec2[axis] = dir;
+					Plane3f local;
+					local.normal() = vector3_cross( vec, vec2 );
+					if ( VectorNormalize( local.normal() ) < 0.5f ) {
+						continue;
+					}
+					local.dist() = vector3_dot( w[ j ], DoubleVector3( local.normal() ) );
