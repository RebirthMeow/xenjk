+							}
+							break;
+						}
+						const size_t k = iside - sides.begin();
+						if ( k >= count || win[ k ].empty() ) {
+							continue;
+						}
+						double minBack = 0;
+						bool front = false;
+						for ( const DoubleVector3& point : win[ k ] ) {
