+   steps without the float copy); a bevel side or a degenerate winding gets an empty one. With whole-unit anchors and
+   plane points on a binary grid the result is the same in any frame the brush is compiled in. */
+void AnchoredBrushWindings( const brush_t& brush, const DoubleVector3& anchor, std::vector<winding_accu_t>& out ){
+	out.assign( brush.sides.size(), winding_accu_t() );
+	std::vector<Plane3> planes( brush.sides.size() );
+	for ( size_t i = 0; i < brush.sides.size(); ++i ){
+		const side_t& side = brush.sides[ i ];
+		const Plane3 p = ( side.plane.normal() != g_vector3_identity )? side.plane : Plane3( mapplanes[ side.planenum ].plane );
+		planes[ i ] = plane3_flipped( plane3_translated( p, -anchor ) );
+	}
+	for ( size_t i = 0; i < brush.sides.size(); ++i )
+	{
+		const side_t& side = brush.sides[ i ];
+		if ( side.bevel ) {
+			continue;
+		}
+		winding_accu_t w = BaseWindingForPlaneAccu( plane3_flipped( planes[ i ] ) );
+		for ( size_t j = 0; j < brush.sides.size() && !w.empty(); ++j )
+		{
+			const side_t& cside = brush.sides[ j ];
+			if ( i == j || cside.bevel || cside.planenum == ( side.planenum ^ 1 ) ) {
+				continue;
+			}
+			ChopWindingInPlaceAccu( w, planes[ j ], 0 );
+		}
+		FixWindingAccu( w );
+		if ( w.size() >= 3 ) {
+			out[ i ].swap( w );
+		}
+	}
+}
