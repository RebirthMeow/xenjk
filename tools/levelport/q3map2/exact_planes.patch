+/* xenjk 2026-10-31, -xplanes: every brush written to <source>.xplanes as well, its sides' planes in double (section 15
+   of docs/levelport-collision.md): records of int32 entity, contents, side count, then a side's normal and distance as
+   four doubles and an int32 kind (0 face, 1 edge or box bevel, 2 none recorded: the float plane). */
+bool writeXplanes = false;
+
+static void EmitXplanes( const entity_t& e, const brush_t& b ){
+	static FILE *f = nullptr;
+	if ( f == nullptr ) {
+		const auto path = StringOutputStream( 256 )( source, ".xplanes" );
+		f = SafeOpenWrite( path.c_str() );
+		fwrite( "XPL1", 1, 4, f );
+	}
+	const int head[ 3 ] = { int( &e - entities.data() ), b.contentShader->contentFlags, int( b.sides.size() ) };
+	fwrite( head, sizeof( int ), 3, f );
+	for ( const side_t& side : b.sides ) {
+		const bool have = side.xplane.normal() != g_vector3_identity;
+		const Plane3 p = have ? side.xplane : Plane3( mapplanes[ side.planenum ].plane );
+		const double v[ 4 ] = { p.normal()[0], p.normal()[1], p.normal()[2], p.dist() };
+		const int kind = !have ? 2 : side.bevel ? 1 : 0;
+		fwrite( v, sizeof( double ), 4, f );
+		fwrite( &kind, sizeof( int ), 1, f );
+	}
+	fflush( f );
+}
