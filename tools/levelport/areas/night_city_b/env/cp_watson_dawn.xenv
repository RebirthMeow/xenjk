xenv 1
# Night City at 06:05, golden hour (renderer session 2026-11-05, for the owner's ref04: low warm sun, long shadows,
# clear air). A second day file beside cp_watson_day.xenv (13:00): +set r_sceneEnv maps/cp_watson_dawn.xenv. CP2077's
# values are its master environment base\weather\24h_basic\cp2077_master_env_ep1_v006.env sampled at 06:05 and 13:00
# (dayenv/env_at.py, env_0605_1300.txt); each value below is the day file's scaled by CP2077's 06:05 / 13:00 ratio,
# except where marked "renderer:".
time day
# The sun: LightDirectionSettings latitude 35, summer, noon at 12:00 (the day file's 13:00 sun, elevation 72.6 azimuth
# 232, checks): at 06:05 elevation 14.2, azimuth 71 (east-north-east) -> yaw 18.9. LightColorSettings.light.sunColor
# (1, 0.79, 0.579) x 0.213 against 13:00's (1, 0.934, 0.878) x 1.041: a fifth of noon's light, orange.
# (2026-11-05, coordinator) the sun: CP2077's trajectory (latitude 35, summer) with its clock 1 h ahead of
# solar time, one constant for every hour, from ref04's cast shadows (sheets/solve/sun_offset.jpg, sun_elev.jpg):
# 06:05 -> 07:05 solar, yaw 11.5, elevation 26.0 (the uncorrected model's 18.9 / 14.2 shaded the foreground)
sun 1 0.79 0.579 0.205 11.5 26.0
r_sceneCharSun 1
r_sceneSun 130
# The sky: AtmosphereAreaSettings skydomeColor (0.84, 0.80, 1) x 1.15 against white x 1.3; lutTurbidity 2.5 against 1.
# Zenith: the day file's x the tint x 1.15 / 1.3. Horizon: x DistantFog albedoNear's 06:05 / 13:00 (0.84, 0.75, 0.77)
# x 1.15 / 1.3, then renderer: warmed toward the low sun's colour.
r_sceneSky 1
r_sceneSkyZenith 0.97 2.34 10.6
r_sceneSkyHorizon 9.5 15 19
r_sceneSkySun 1
# Ambient: skylightColor (0.914, 0.949, 1) x 1.25 against white x 1.3: the day file's x 0.96 x the tint, then
# renderer: x 0.7 (A/B: the shade toward ref04's; 2.8 3.1 3.75 lifted it)
r_sceneAmbient 3.0 3.6 5.5
# Exposure: ExposureAreaSettings exposureMax 4.44 against 5.38 (compensation -0.65 both): auto exposure may open
# 2^0.94 = 1.92x the noon's. renderer, A/B 2026-11-05 (sheets/dawn): the noon's 0.04 matches ref04 best (centre 125
# against CP2077's 121; 0.06 150, 0.077 163).
r_sceneExposure 0.04
r_sceneEmissive 1
# Haze: DistantFog density 1.22 against 1.27, albedoNear (0.69, 0.70, 0.79) against (0.82, 0.93, 1.02); Volumetric
# globalLightScale 0.0075 against 0.01, ambientScale 0.12 against 0.05. renderer: the owner's ref04 shows clear air to the
# far towers where the day file's 0.002 washes them out at 13:00 too (CP2077's distant fog is about as dense at both
# hours); 0.0007 halves the light at 1 km. Colour greyer and warmer, as albedoNear.
r_sceneFog 118 132 150
r_sceneFogDensity 0.0003
r_sceneFogHeight 125
r_sceneFogLight 0.3
r_sceneFogStart 200
r_sceneFogMoon 0.0075
r_sceneDayLamps 0
r_sceneWet 0

# (2026-11-05, coordinator, dawn look 1 from ref04 region means at the solved camera, look grids
# cams_ref04_grid*.txt: haze blue-grey and thinner (far haze within ~5 of CP2077, was +60), a bluer, stronger sky
# fill (shadows were dark and yellow), sun 130)
# (2026-11-05, coordinator) glows hold their on-screen brightness at every hour: r_sceneEmissiveExposure 0 against
# the night's exposure 1.3 (renderer H21; replaces r_sceneEmissive 32); the foliage canopy shading and day clouds
# at the renderer session's recommended values (H19+: r_sceneFoliage, r_sceneClouds)
r_sceneEmissiveExposure 0
r_sceneEmissiveRef 1.3
r_sceneFoliage 0.7
r_sceneClouds 0.35
# (2026-11-05, coordinator) eye adaptation (renderer H27, r_sceneAutoExposure): the exposure moves within
# CP2077's window at 06:05, ExposureAreaSettings exposureMin / exposureMax in EV about r_sceneExposure
r_sceneExposureWindow -1.2 4.44
