#version 450
// Render scenes (vk_scene.cpp): screen-space reflections, traced and settled over frames. Runs after
// scene_capture.comp, on this frame's half-size history (rgb the shown colour, a the view depth). Per texel: the
// surface rebuilt from depth (position, and the normal from its neighbours' depths), wet where it faces up; its
// reflected ray marched through the same history (a start and a glossy spread that change every frame); then the
// result blended into last frame's, reprojected with that frame's camera and kept only where the surface matches.
// Characters (negative depth in the history) are neither hit nor mirrored from: a ray passes through them.
// Out: rgb the light the surface mirrors (linear, before exposure, before Fresnel), a its view depth (0: not wet).
// scene.frag reads it the next frame and applies its own wetness and Fresnel.
// Also, when opts2.z > 0 (r_sceneAO): ambient occlusion on every texel, from the same depths: opts2.z samples in the
// hemisphere about the rebuilt normal, out to opts2.y units, settled over frames like the reflections. Out (aoImg): r the
// share of the ambient light that reaches the surface, g its view depth (0: none). scene.frag reads it the next frame and
// multiplies its ambient light (not the sun's or the lamps') by it.
// With it, when contact.w > 0 (r_sceneContactShadow): contact shadows, the short ray toward the sun marched through the same
// depths (contact2.x jittered steps out to contact.w units; a step counts as hidden where the history shows something
// in front of it by less than contact2.y): the sun's cascades miss the small shadows under a step's lip, a pot's foot,
// a character's feet. Out: aoImg b, the share of the sun that passes (1 where it was not marched); scene.frag's sun.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D historyTex;		// this frame (scene_capture.comp)
layout(set = 0, binding = 4) uniform sampler2D historyDepthTex;	// its depth alone (r16f: a quarter of the bytes per step)
layout(constant_id = 0) const int kDepthChannel = 0;	// 0: the r16f copy; 3: the history itself (no r16f storage)
layout(set = 0, binding = 1) uniform sampler2D prevAccumTex;	// last frame's result
layout(set = 0, binding = 2, rgba16f) uniform writeonly image2D accumImg;
layout(set = 0, binding = 5, rgba16f) uniform writeonly image2D aoImg;	// the occlusion (r_sceneAO)
layout(set = 0, binding = 6) uniform sampler2D prevAoTex;				// last frame's
layout(set = 0, binding = 7) uniform sampler2D reflTex;	// the area's baked reflection capture (p.refl.x: loaded)
layout(set = 0, binding = 8, rgba16f) uniform writeonly image2D bounceImg;	// the bounce light (r_sceneBounce)
layout(set = 0, binding = 9) uniform sampler2D prevBounceTex;			// last frame's
layout(std140, set = 0, binding = 3) uniform Params {
	mat4 viewProj;		// this frame's camera (Vulkan clip space)
	mat4 prevViewProj;	// the camera prevAccumTex was made with
	vec4 eye;			// w: frame number
	vec4 fwd;			// w: tan(fovX / 2)
	vec4 left;			// w: tan(fovY / 2)
	vec4 up;			// w: the farthest ray (units)
	vec4 prevEye;		// w: steps
	vec4 prevFwd;		// w: 1 when prevAccumTex holds last frame's result
	vec4 sky;			// rgb: the haze's colour as linear light (misses); w: the share of a new frame in the blend
	vec4 wet;			// x: wetness on (0 off), y: puddle share, z: exposure, w: tone curve (0 exponential, 1 filmic)
	vec4 opts;			// x: rays a texel with history (r_sceneSsrRays, 1 or 2); y, z: the water's band (its surfaces' lowest and
					// highest z, units); w: 1 when the scene has water
	vec4 opts2;			// x: the up-facing cosine past which the surface counts as level ground (r_sceneSsrFlat; 2: never);
					// y: the occlusion's reach (units), z: its samples (0: off), w: the share of a new frame in its blend
	vec4 refl;			// x: 1 when reflTex holds the area's reflection capture (a miss takes it), y: its scale; z, w:
						// r_sceneToneAdjust's gain and gamma (0: off)
	vec4 contact;		// xyz: toward the sun; w: the contact shadow's length (units; 0 off)
	vec4 contact2;		// x: its steps, y: the thickness a depth is taken to have (units), z: the eye distance it fades out by
	vec4 gloss;			// x: 1 to trace every dry texel (r_sceneSsrGlossy) at roughness y; z: 1 for the bounce light (r_sceneBounce)
	vec4 mirror;		// r_sceneWaterMirror (mirrorProxy): xyz the mirrored model's origin, w 1 when there is one
	vec4 mirrorAxis[3];	// world to model: each axis over its length squared
	vec4 mirrorBox[2];	// its proxy's box in model units: x0 y0 z0, x1 y1 z1
	vec4 mirrorLight[3];	// the model's light as its diffuse takes it: ambient, directed (0..1), the light in model space
} p;
layout(set = 0, binding = 10) uniform sampler2D mirrorTex;	// the mirrored model's proxy: rgb its albedo from below, a its height

const float UNITS_PER_METRE = 37.5;
const float WET_ROUGH = 0.2;	// scene.frag's
const float WATER_ROUGH = 0.05;	// the water's gloss here (scene.frag's roughness is the material's)

// scene.frag's fromDisplay: the frame's encoding back to linear light (before exposure), the headroom past TONE_TOP
// included
const float TONE_TOP = 0.999, TONE_LOG = 0.1;
// r_sceneTonemap 2: Gran Turismo 7's tone curve (Polyphony Digital, SDR at a 100 nit paper white, as ShaderInjector's
// TONEMAP_GRAN_TURISMO_7): a toe, a linear section and a shoulder converging on the peak, per channel; gt7Inverse takes
// the per-channel curve back (its ICtCp chroma blend, scene.frag's alone, is not inverted)
const float GT7_MID = 0.538, GT7_LIN = 0.444, GT7_TOE = 1.28;
const float GT7_KA = 1.185333, GT7_KB = -1.349340, GT7_KC = -1.348921;	// (alpha 0.25, peak 1)
float gt7Curve( const float x )
{
	if ( x <= 0.0 )
		return 0.0;
	if ( x < GT7_LIN ) {
		const float wl = smoothstep( 0.0, GT7_MID, x );
		return ( 1.0 - wl ) * GT7_MID * pow( x / GT7_MID, GT7_TOE ) + wl * x;
	}
	return min( GT7_KA + GT7_KB * exp( x * GT7_KC ), 1.0 );
}
float gt7Inverse( const float y )
{
	if ( y <= 0.0 )
		return 0.0;
	if ( y >= GT7_LIN )
		return log( max( ( min( y, 0.99999 ) - GT7_KA ) / GT7_KB, 1e-6 ) ) / GT7_KC;
	float x = y;
	for ( int i = 0; i < 6; i++ ) {	// (Newton on the toe's blend: monotonic, a few steps)
		const float e = 1e-4, f = gt7Curve( x ) - y, df = ( gt7Curve( x + e ) - gt7Curve( x ) ) / e;
		x = clamp( x - f / max( df, 1e-3 ), 0.0, GT7_LIN );
	}
	return x;
}
vec3 toneInverse( vec3 y )
{
	y = pow( clamp( y, 0.0, TONE_TOP ), vec3( 2.2 ) );
	if ( p.wet.w > 1.5 )	// (r_sceneTonemap 2: GT7)
		return vec3( gt7Inverse( y.r ), gt7Inverse( y.g ), gt7Inverse( y.b ) );
	if ( p.wet.w > 0.5 ) {
		const vec3 a = 2.51 - 2.43 * y, b = 0.03 - 0.59 * y, c = -0.14 * y;
		return ( -b + sqrt( b * b - 4.0 * a * c ) ) / ( 2.0 * a );
	}
	return -log( 1.0 - y );
}
vec3 fromDisplay( const vec3 y )
{
	const float top = toneInverse( vec3( TONE_TOP ) ).x;
	vec3 c = mix( toneInverse( y ), top * exp( ( y - TONE_TOP ) / TONE_LOG ), greaterThan( y, vec3( TONE_TOP ) ) );
	if ( p.refl.w > 0.0 )	// r_sceneToneAdjust's inverse (scene.frag's toneAdjustInverse)
		c = pow( max( c, vec3( 0.0 ) ), vec3( p.refl.w ) ) / p.refl.z;
	return c / p.wet.z;
}

// the world point a history texel shows (view depth d along this frame's rays)
vec3 position( const vec2 uv, const float d )
{
	return p.eye.xyz + d * ( p.fwd.xyz + ( 1.0 - 2.0 * uv.x ) * p.fwd.w * p.left.xyz + ( 1.0 - 2.0 * uv.y ) * p.left.w * p.up.xyz );
}

// gradient noise for the puddles, as scene.frag lays them
float hash( const vec2 q ) { return fract( sin( dot( q, vec2( 127.1, 311.7 ) ) ) * 43758.5453 ); }
vec2 gradient( const vec2 i ) { const float a = hash( i ) * 6.2831853; return vec2( cos( a ), sin( a ) ); }
float gradientNoise( const vec2 q )
{
	const vec2 i = floor( q ), f = fract( q ), u = f * f * f * ( f * ( f * 6.0 - 15.0 ) + 10.0 );
	const float a = dot( gradient( i ), f ), b = dot( gradient( i + vec2( 1.0, 0.0 ) ), f - vec2( 1.0, 0.0 ) );
	const float c = dot( gradient( i + vec2( 0.0, 1.0 ) ), f - vec2( 0.0, 1.0 ) ), d = dot( gradient( i + 1.0 ), f - 1.0 );
	return 0.5 + 0.75 * mix( mix( a, b, u.x ), mix( c, d, u.x ), u.y );
}

// interleaved gradient noise, moved on every frame
float ign( const vec2 px, const float frame ) { return fract( 52.9829189 * fract( dot( px + 5.588238 * frame, vec2( 0.06711056, 0.00583715 ) ) ) ); }

// whether the surface a history texel shows faces up (its normal from the neighbours' depths, as for the reflecting
// surface): a reflected ray rises, so it cannot meet the top of a deck; it passed under it
bool facesUp( const vec2 uv, const float d )
{
	const vec2 texel = 1.0 / vec2( textureSize( historyTex, 0 ) );
	const float dr = abs( textureLod( historyDepthTex, uv + vec2( texel.x, 0.0 ), 0.0 )[kDepthChannel] );
	const float dd = abs( textureLod( historyDepthTex, uv + vec2( 0.0, texel.y ), 0.0 )[kDepthChannel] );
	if ( dr <= 0.0 || dd <= 0.0 || abs( dr - d ) > 0.1 * d || abs( dd - d ) > 0.1 * d )
		return false;
	const vec3 P = position( uv, d );
	const vec3 n = normalize( cross( position( uv + vec2( 0.0, texel.y ), dd ) - P, position( uv + vec2( texel.x, 0.0 ), dr ) - P ) );
	return abs( n.z ) > 0.7 && dot( n * sign( n.z ), normalize( p.eye.xyz - P ) ) > 0.0;
}

// r_sceneWaterMirror: a model the water mirrors by its proxy where the ray left the screen (its underside seen from below,
// tools/mirror_proxy.py: the Star Destroyer over Beauclair, off screen whenever its reflection is on it). The ray from P
// along R in the model's space, marched between the proxy's lowest and highest heights inside its box (24 steps, then 5
// halvings), the first point at or above the underside; there its albedo lit as the model's diffuse lights it (the
// classic generic shader: ambient + N.L x directed, each channel at most 1, N.L by its unnormalised light as the model
// takes it) on the display scale the model is drawn on, back to linear light. rgb that light, a 1 where the ray hits it
vec4 mirrorProxy( const vec3 P, const vec3 R )
{
	if ( p.mirror.w < 0.5 )
		return vec4( 0.0 );
	const vec3 v = P - p.mirror.xyz;
	const vec3 o = vec3( dot( v, p.mirrorAxis[0].xyz ), dot( v, p.mirrorAxis[1].xyz ), dot( v, p.mirrorAxis[2].xyz ) );
	const vec3 d = vec3( dot( R, p.mirrorAxis[0].xyz ), dot( R, p.mirrorAxis[1].xyz ), dot( R, p.mirrorAxis[2].xyz ) );
	const vec3 lo = p.mirrorBox[0].xyz, hi = p.mirrorBox[1].xyz;
	if ( d.z <= 1e-6 * length( d ) )
		return vec4( 0.0 );
	float t0 = ( lo.z - o.z ) / d.z, t1 = ( hi.z - o.z ) / d.z;
	for ( int k = 0; k < 2; k++ ) {
		if ( abs( d[k] ) < 1e-9 ) {
			if ( o[k] < lo[k] || o[k] > hi[k] )
				return vec4( 0.0 );
			continue;
		}
		const float a = ( lo[k] - o[k] ) / d[k], b = ( hi[k] - o[k] ) / d[k];
		t0 = max( t0, min( a, b ) );
		t1 = min( t1, max( a, b ) );
	}
	t0 = max( t0, 0.0 );
	if ( t1 <= t0 )
		return vec4( 0.0 );
	const vec2 span = hi.xy - lo.xy;
	const vec2 size = vec2( textureSize( mirrorTex, 0 ) );
	// the level: a texel against this texel's footprint there (the eye's path to the water and on to the model)
	const float world = 1.0 / max( length( p.mirrorAxis[0].xyz ), 1e-9 );	// world units per model unit
	const float pixel = 2.0 * p.left.w / max( float( textureSize( historyTex, 0 ).y ), 1.0 );
	const float lod = max( log2( max( ( length( P - p.eye.xyz ) + t0 ) * pixel / ( span.x / size.x * world ), 1e-6 ) ), 0.0 );
	const float zs = ( hi.z - lo.z ) * 255.0 / 250.0;	// a x 255 / 250 of the way from z0 to z1; 255: no hull
	float ta = t0, tb = -1.0;
	for ( int i = 1; i <= 24; i++ ) {
		const float t = mix( t0, t1, float( i ) / 24.0 );
		const vec3 q = o + d * t;
		const float a = textureLod( mirrorTex, ( q.xy - lo.xy ) / span, lod ).a;
		if ( a < 252.0 / 255.0 && q.z >= lo.z + a * zs ) {
			tb = t;
			break;
		}
		ta = t;
	}
	if ( tb < 0.0 )
		return vec4( 0.0 );
	for ( int i = 0; i < 5; i++ ) {
		const float t = 0.5 * ( ta + tb );
		const vec3 q = o + d * t;
		const float a = textureLod( mirrorTex, ( q.xy - lo.xy ) / span, lod ).a;
		if ( a < 252.0 / 255.0 && q.z >= lo.z + a * zs )
			tb = t;
		else
			ta = t;
	}
	const vec2 uv = ( o.xy + d.xy * tb - lo.xy ) / span;
	const vec4 s = textureLod( mirrorTex, uv, lod );
	// the underside's normal (facing down) from the height's slope across a texel at this level
	const vec2 du = exp2( lod ) / size;
	const float hx = ( textureLod( mirrorTex, uv + vec2( du.x, 0.0 ), lod ).a - textureLod( mirrorTex, uv - vec2( du.x, 0.0 ), lod ).a ) * zs;
	const float hy = ( textureLod( mirrorTex, uv + vec2( 0.0, du.y ), lod ).a - textureLod( mirrorTex, uv - vec2( 0.0, du.y ), lod ).a ) * zs;
	const vec3 n = normalize( vec3( hx / ( 2.0 * du.x * span.x ), hy / ( 2.0 * du.y * span.y ), -1.0 ) );
	const float incoming = dot( n, p.mirrorLight[2].xyz );
	const vec3 light = incoming > 0.0 ? min( p.mirrorLight[0].rgb + incoming * p.mirrorLight[1].rgb, vec3( 1.0 ) ) : p.mirrorLight[0].rgb;
	return vec4( fromDisplay( s.rgb * light ), 1.0 );
}

// a missed ray's sky: the history where its direction meets the frame (a point at infinity: the sky does not move with
// the ray's start), if the frame shows open sky there (depth 0): the sky and its clouds as drawn, mirrored. 0: none
vec4 skyAlong( const vec3 R )
{
	const vec4 c = p.viewProj * vec4( R, 0.0 );
	if ( c.w <= 1e-4 )
		return vec4( 0.0 );
	const vec2 uv = c.xy / c.w * 0.5 + 0.5;
	if ( any( lessThan( uv, vec2( 0.0 ) ) ) || any( greaterThan( uv, vec2( 1.0 ) ) ) )
		return vec4( 0.0 );
	if ( textureLod( historyDepthTex, uv, 0.0 )[kDepthChannel] != 0.0 )
		return vec4( 0.0 );
	return vec4( fromDisplay( textureLod( historyTex, uv, 0.0 ).rgb ), 1.0 );
}

// the area's baked reflection capture along scene direction R at a roughness (scene.frag's pleReflect: its BC6H cube's
// faces in a 4 x 2 atlas, UE axes, UE's level for the roughness), as linear light
vec3 reflSky( const vec3 R, const float rough )
{
	const vec3 d = vec3( R.x, -R.y, R.z ), a = abs( d );
	int face;
	vec2 uv;
	if ( a.x >= a.y && a.x >= a.z ) {
		face = d.x > 0.0 ? 0 : 1;
		uv = vec2( d.x > 0.0 ? -d.z : d.z, -d.y ) / a.x;
	} else if ( a.y >= a.z ) {
		face = d.y > 0.0 ? 2 : 3;
		uv = vec2( d.x, d.y > 0.0 ? d.z : -d.z ) / a.y;
	} else {
		face = d.z > 0.0 ? 4 : 5;
		uv = vec2( d.z > 0.0 ? d.x : -d.x, -d.y ) / a.z;
	}
	const float mip = clamp( 7.0 + 1.2 * log2( max( rough, 0.001 ) ), 0.0, 6.0 );
	const float inset = 0.5 / float( 256 >> int( ceil( mip ) ) );
	uv = clamp( uv * 0.5 + 0.5, inset, 1.0 - inset );
	return textureLod( reflTex, ( vec2( face & 3, face >> 2 ) + uv ) * vec2( 0.25, 0.5 ), mip ).rgb * p.refl.y;
}

// the reflected ray through the history: linear light and its weight (0 missed); a miss takes `sky` of the haze
// (0.5 out of the top of the view, else 0.25: the city's sky is mostly buildings). Under a deck, the ray's hit on the
// deck's visible top is the deck's dark underside instead: no light, full weight.
vec4 trace( const vec3 P, const vec3 R, const float jitter, const float cone, out float sky )
{
	sky = 0.5;
	// the hit's colour from the history level as wide as the glossy cone where it lands (cone: its full angle), so a
	// thin bright thing (a saber blade) mirrors as a streak, not as beads where single steps landed on it
	const vec4 c0 = p.viewProj * vec4( P, 1.0 );
	const vec2 uv0 = c0.xy / max( c0.w, 1e-3 ) * 0.5 + 0.5;
	const vec2 texels = vec2( textureSize( historyTex, 0 ) );
	const float maxLod = float( textureQueryLevels( historyTex ) - 1 );
	const int steps = int( p.prevEye.w );
	const float growth = pow( p.up.w / 8.0, 1.0 / float( steps - 1 ) );
	float tPrev = 0.0, t = 8.0 * ( 0.5 + jitter );
	float fPrev = 1.0;	// the depth difference at tPrev (negative: in front of the surface there; 1: unknown)
	for ( int i = 0; i < steps; i++ ) {
		const vec3 Q = P + R * t;
		const vec4 c = p.viewProj * vec4( Q, 1.0 );
		if ( c.w <= 1.0 )
			break;
		const vec2 uv = c.xy / c.w * 0.5 + 0.5;
		if ( any( lessThan( uv, vec2( 0.0 ) ) ) || any( greaterThan( uv, vec2( 1.0 ) ) ) ) {
			sky = uv.y < 0.0 ? 0.5 : 0.25;
			return vec4( 0.0 );
		}
		const float zq = dot( Q - p.eye.xyz, p.fwd.xyz );
		const float d = textureLod( historyDepthTex, uv, 0.0 )[kDepthChannel];
		if ( d > 0.0 && zq > d ) {
			if ( zq - d > max( 37.5, 0.06 * zq ) + ( t - tPrev ) ) {
				// behind something thick: not a hit; the ray goes on and may come out past it
				tPrev = t;
				fPrev = 1.0;
				t *= growth;
				continue;
			}
			// halved four times, then placed between the bracket's depth differences (in front at lo, behind at hi):
			// the halving alone snapped the hit to 16 points a step, so rows of ground texels shared one and a
			// reflected upright showed as horizontal stair-steps
			float lo = tPrev, hi = t, flo = fPrev, fhi = zq - d;
			vec2 hitUv = uv;
			for ( int k = 0; k < 4; k++ ) {
				const float m = 0.5 * ( lo + hi );
				const vec3 Qm = P + R * m;
				const vec4 cm = p.viewProj * vec4( Qm, 1.0 );
				const vec2 um = cm.xy / cm.w * 0.5 + 0.5;
				const float dm = textureLod( historyDepthTex, um, 0.0 )[kDepthChannel];
				const float zm = dot( Qm - p.eye.xyz, p.fwd.xyz );
				if ( dm > 0.0 && zm > dm ) {
					hi = m;
					fhi = zm - dm;
					hitUv = um;
				} else {
					lo = m;
					flo = dm > 0.0 ? zm - dm : 1.0;
				}
			}
			if ( flo < 0.0 && fhi > 0.0 ) {
				const vec4 cs = p.viewProj * vec4( P + R * mix( lo, hi, flo / ( flo - fhi ) ), 1.0 );
				hitUv = cs.xy / cs.w * 0.5 + 0.5;
			}
			const vec2 e = smoothstep( vec2( 0.0 ), vec2( 0.08 ), hitUv ) * smoothstep( vec2( 0.0 ), vec2( 0.08 ), 1.0 - hitUv );
			const float w = e.x * e.y * ( 1.0 - smoothstep( 0.6, 1.0, t / p.up.w ) );
			const vec4 h = textureLod( historyTex, hitUv, 0.0 );
			if ( R.z > 0.2 && facesUp( hitUv, h.a ) ) {
				// a rising ray behind an up-facing surface: under a deck when it is below that surface (its dark underside),
				// else it passed over a thin top (a kiosk's, a sign's, the ground at an upright's foot) and goes on; every
				// such step was black, so the reflection of an upright had black rows along its top and bottom edges
				if ( ( P + R * hi ).z < position( hitUv, abs( h.a ) ).z )
					return vec4( 0.0, 0.0, 0.0, w );
				tPrev = t;
				fPrev = 1.0;
				t *= growth;
				continue;
			}
			const float lod = clamp( log2( max( length( ( hitUv - uv0 ) * texels ) * cone, 1.0 ) ), 0.0, maxLod );
			return vec4( fromDisplay( lod > 0.0 ? textureLod( historyTex, hitUv, lod ).rgb : h.rgb ), w );
		}
		tPrev = t;
		fPrev = d > 0.0 ? zq - d : 1.0;
		t *= growth;
	}
	sky = 0.25;
	return vec4( 0.0 );
}

// the share of the ambient light reaching P (normal Ng, view depth d): cosine-weighted directions about the normal, each
// to a distance within the reach; a sample counts as hidden where the history shows something in front of it, by less
// than the reach farther from P's own depth (a far wall behind an edge does not darken it)
// with p.gloss.z (r_sceneBounce, ShaderInjector's SSGI bounce light in a simpler form): each hidden sample also brings
// back the light the frame shows where it is hidden (the occluder's face toward the eye, linear light before
// exposure), weighted as its occlusion: bounce, the mean over the samples (the cosine-weighted mean of the light
// coming in, scene.frag's diffuse times the albedo)
float occlusion( const vec3 P, const vec3 Ng, const float d, const ivec2 id, out vec3 bounce )
{
	bounce = vec3( 0.0 );
	const int n = int( p.opts2.z );
	const float reach = p.opts2.y;
	const vec3 T = normalize( cross( Ng, abs( Ng.z ) < 0.9 ? vec3( 0.0, 0.0, 1.0 ) : vec3( 1.0, 0.0, 0.0 ) ) );
	const vec3 B = cross( Ng, T );
	const float j1 = ign( vec2( id ) + 11.0, p.eye.w ), j2 = ign( vec2( id.yx ) + 47.0, p.eye.w + 7.0 );
	const vec3 O = P + Ng * max( 1.0, 0.002 * d );
	float hidden = 0.0;
	for ( int k = 0; k < n; k++ ) {
		const float u = ( float( k ) + j1 ) / float( n );
		const float phi = 6.2831853 * fract( float( k ) * 0.618034 + j2 );
		const float r = sqrt( u );
		const vec3 dir = T * ( r * cos( phi ) ) + B * ( r * sin( phi ) ) + Ng * sqrt( max( 1.0 - u, 0.0 ) );
		const float s = fract( j2 * 3.7 + float( k ) * 0.381966 );
		const vec3 Q = O + dir * ( reach * mix( 0.08, 1.0, s * s ) );
		const vec4 c = p.viewProj * vec4( Q, 1.0 );
		if ( c.w <= 1.0 )
			continue;
		const vec2 uv = c.xy / c.w * 0.5 + 0.5;
		if ( any( lessThan( uv, vec2( 0.0 ) ) ) || any( greaterThan( uv, vec2( 1.0 ) ) ) )
			continue;
		const float zq = dot( Q - p.eye.xyz, p.fwd.xyz );
		const float ds = abs( textureLod( historyDepthTex, uv, 0.0 )[kDepthChannel] );	// (a character occludes too)
		if ( ds > 0.0 && ds < zq - max( 1.0, 0.003 * zq ) ) {
			const float w = smoothstep( 0.0, 1.0, reach / max( abs( d - ds ), 1e-3 ) );
			hidden += w;
			if ( p.gloss.z > 0.5 )
				bounce += fromDisplay( textureLod( historyTex, uv, 0.0 ).rgb ) * w;
		}
	}
	bounce /= float( max( n, 1 ) );
	return 1.0 - hidden / float( max( n, 1 ) );
}

// a segment's share left inside the clip volume's side a >= 0 (a at its start, b at its end): t, cut where it leaves
void clipAgainst( const float a, const float b, inout float t )
{
	if ( a < 0.0 && b < 0.0 )
		t = 0.0;
	else if ( b < 0.0 )
		t = min( t, a / ( a - b ) );
}

// the share of the sun reaching P (normal Ng, view depth d) past what stands within contact.w of it, as ShaderInjector's
// FF7 Rebirth contact shadows: the ray toward the sun cut to the view, stepped evenly on screen (contact2.x steps,
// interleaved gradient noise jitter) with its view depth perspective-correct; each step a segment of the ray, hidden
// where its depths overlap [the texel's depth + a bias, + a thickness] (a span, not a point: a thin pole is caught
// between steps; the thickness the mod's, contact2.y, plus the half-float depth's rounding); the first steps skipped
// on the receiver (more at grazing light), and the texel itself, and a ray under 0.75 texels long; a hit's shadow
// t^2 along the ray (the tip fades), the least kept, ^3. Faded out by eye distance (contact2.z)
float contactShadow( const vec3 P, const vec3 Ng, const float d, const ivec2 id )
{
	const vec3 L = p.contact.xyz;
	const float NdotL = dot( Ng, L );
	if ( NdotL <= 0.0 || d > p.contact2.z )
		return 1.0;
	const int n = int( p.contact2.x );
	const float invN = 1.0 / float( n );
	const vec3 O = P + Ng * max( 1.0, 0.002 * d );
	const vec4 c0 = p.viewProj * vec4( O, 1.0 );
	vec4 c1 = p.viewProj * vec4( O + L * p.contact.w, 1.0 );
	if ( c0.w <= 1.0 )
		return 1.0;
	float tExit = 1.0;
	clipAgainst( c0.w - 1.0, c1.w - 1.0, tExit );
	clipAgainst( c0.x + c0.w, c1.x + c1.w, tExit );
	clipAgainst( c0.w - c0.x, c1.w - c1.x, tExit );
	clipAgainst( c0.y + c0.w, c1.y + c1.w, tExit );
	clipAgainst( c0.w - c0.y, c1.w - c1.y, tExit );
	if ( tExit <= 1e-4 )
		return 1.0;
	c1 = mix( c0, c1, tExit );
	const vec2 size = vec2( imageSize( aoImg ) );
	const vec2 uv0 = c0.xy / c0.w * 0.5 + 0.5, uv1 = c1.xy / c1.w * 0.5 + 0.5;
	if ( length( ( uv1 - uv0 ) * size ) < 0.75 )
		return 1.0;
	const float iw0 = 1.0 / c0.w, iw1 = 1.0 / c1.w;	// (clip w is the view depth: its reciprocal runs linear on screen)
	const float j = ign( vec2( id ) + 23.0, p.eye.w + 3.0 );
	const float tMin = clamp( ( 0.5 + ( 1.0 - NdotL ) ) * invN, 0.0, 1.0 );
	const ivec2 dsize = textureSize( historyDepthTex, 0 );
	float z0 = 1.0 / mix( iw0, iw1, tMin );
	float occ = 1.0;
	for ( int k = 0; k < n; k++ ) {
		const float st = ( float( k ) + j ) * invN;
		const float tEnd = k == n - 1 ? 1.0 : min( st + 0.5 * invN, 1.0 );
		if ( tEnd <= tMin )
			continue;
		const float z1 = 1.0 / mix( iw0, iw1, tEnd );
		const vec2 uv = mix( uv0, uv1, st );
		if ( any( lessThan( uv, vec2( 0.0 ) ) ) || any( greaterThan( uv, vec2( 1.0 ) ) ) )
			break;
		const vec2 off = ( uv - uv0 ) * size;
		if ( dot( off, off ) >= 0.25 ) {
			const ivec2 at = clamp( ivec2( uv * vec2( dsize ) ), ivec2( 0 ), dsize - 1 );
			const float ds = abs( texelFetch( historyDepthTex, at, 0 )[kDepthChannel] );	// (a character casts too)
			if ( ds > 0.0 ) {
				const float q = ds * ( 1.0 / 1024.0 );	// (the half float's step at this depth, at most)
				if ( max( z0, z1 ) > ds + q && min( z0, z1 ) < ds + p.contact2.y + 2.0 * q )
					occ = min( occ, st * st );
			}
		}
		z0 = z1;
	}
	occ = occ * occ * occ;
	return mix( occ, 1.0, smoothstep( 0.6 * p.contact2.z, p.contact2.z, d ) );
}

// the occlusion at this texel (normal Ng, or none where valid is false), settled with last frame's where the same
// surface was
// (aoOut: what was stored, for r_sceneSsrGlossy's hit share in its a)
vec4 aoOut = vec4( 1.0, 0.0, 1.0, 1.0 );
void storeOcclusion( const ivec2 id, const vec3 P, const vec3 Ng, const float d, const bool valid )
{
	if ( !valid ) {
		aoOut = vec4( 1.0, 0.0, 1.0, 1.0 );
		imageStore( aoImg, id, aoOut );
		if ( p.gloss.z > 0.5 )
			imageStore( bounceImg, id, vec4( 0.0 ) );
		return;
	}
	vec3 bounce = vec3( 0.0 );
	float ao = p.opts2.z > 0.5 ? occlusion( P, Ng, d, id, bounce ) : 1.0;
	float cs = p.contact.w > 0.0 ? contactShadow( P, Ng, d, id ) : 1.0;
	if ( p.prevFwd.w > 0.5 ) {
		const vec4 c = p.prevViewProj * vec4( P, 1.0 );
		if ( c.w > 1.0 ) {
			const vec2 pu = c.xy / c.w * 0.5 + 0.5;
			if ( all( greaterThanEqual( pu, vec2( 0.0 ) ) ) && all( lessThanEqual( pu, vec2( 1.0 ) ) ) ) {
				const vec4 h = textureLod( prevAoTex, pu, 0.0 );
				const float zp = dot( P - p.prevEye.xyz, p.prevFwd.xyz );
				if ( h.g > 0.0 && abs( h.g - zp ) < 0.05 * zp + 8.0 ) {
					ao = mix( h.r, ao, p.opts2.w );
					cs = mix( h.b, cs, p.opts2.w );
				}
				if ( p.gloss.z > 0.5 ) {
					const vec4 hb = textureLod( prevBounceTex, pu, 0.0 );
					if ( hb.a > 0.0 && abs( hb.a - zp ) < 0.05 * zp + 8.0 )
						bounce = mix( hb.rgb, bounce, p.opts2.w );
				}
			}
		}
	}
	aoOut = vec4( ao, d, cs, 1.0 );	// (a: r_sceneSsrGlossy's hit share; 1 where the reflection is whole or none)
	imageStore( aoImg, id, aoOut );
	if ( p.gloss.z > 0.5 )
		imageStore( bounceImg, id, vec4( bounce, d ) );
}

// r_sceneSsrGlossy (ShaderInjector's stochastic SSR): a dry texel's reflection at the cap's roughness, one ray importance
// sampled from GGX's visible normals (Heitz 2018) about the rebuilt normal, jittered every frame and settled over
// frames as the wet ground's; out the hits alone (premultiplied) and their share in aoImg's a: scene.frag takes the
// probes' reflection for the rest
vec3 sampleVndf( const vec3 Ve, const float alpha, const float u1, const float u2 )
{
	const vec3 Vh = normalize( vec3( alpha * Ve.x, alpha * Ve.y, Ve.z ) );
	const float lensq = Vh.x * Vh.x + Vh.y * Vh.y;
	const vec3 T1 = lensq > 0.0 ? vec3( -Vh.y, Vh.x, 0.0 ) * inversesqrt( lensq ) : vec3( 1.0, 0.0, 0.0 );
	const vec3 T2 = cross( Vh, T1 );
	const float r = sqrt( u1 ), phi = 6.2831853 * u2;
	const float t1 = r * cos( phi ), s = 0.5 * ( 1.0 + Vh.z );
	const float t2 = ( 1.0 - s ) * sqrt( max( 1.0 - t1 * t1, 0.0 ) ) + s * r * sin( phi );
	const vec3 Nh = t1 * T1 + t2 * T2 + sqrt( max( 1.0 - t1 * t1 - t2 * t2, 0.0 ) ) * Vh;
	return normalize( vec3( alpha * Nh.x, alpha * Nh.y, max( Nh.z, 0.0 ) ) );
}
void glossyTrace( const ivec2 id, const vec3 P, const vec3 Ng, const vec3 V, const float d )
{
	const float rough = p.gloss.y, alpha = rough * rough;
	const vec3 T = normalize( cross( Ng, abs( Ng.z ) < 0.9 ? vec3( 0.0, 0.0, 1.0 ) : vec3( 1.0, 0.0, 0.0 ) ) );
	const vec3 B = cross( Ng, T );
	const float j1 = ign( vec2( id ) + 5.0, p.eye.w ), j2 = ign( vec2( id.yx ) + 19.0, p.eye.w + 5.0 ), j3 = ign( vec2( id ) + 41.0, p.eye.w + 11.0 );
	const vec3 Ve = vec3( dot( V, T ), dot( V, B ), dot( V, Ng ) );
	const vec3 He = sampleVndf( Ve, alpha, j1, j2 );
	const vec3 H = T * He.x + B * He.y + Ng * He.z;
	const vec3 R = reflect( -V, H );
	vec4 cur = vec4( 0.0 );	// rgb the hits' light (premultiplied), a their share
	if ( dot( R, Ng ) > 0.0 ) {
		float sky;
		const vec4 hit = trace( P + Ng * 2.0, R, j3, alpha * 4.0, sky );
		cur = vec4( hit.rgb * hit.a, hit.a );
	}
	if ( p.prevFwd.w > 0.5 ) {
		const vec4 c = p.prevViewProj * vec4( P, 1.0 );
		if ( c.w > 1.0 ) {
			const vec2 pu = c.xy / c.w * 0.5 + 0.5;
			if ( all( greaterThanEqual( pu, vec2( 0.0 ) ) ) && all( lessThanEqual( pu, vec2( 1.0 ) ) ) ) {
				const vec4 h = textureLod( prevAccumTex, pu, 0.0 );
				const float zp = dot( P - p.prevEye.xyz, p.prevFwd.xyz );
				if ( h.a > 0.0 && abs( h.a - zp ) < 0.08 * zp + 16.0 ) {
					const vec4 hist = vec4( h.rgb, textureLod( prevAoTex, pu, 0.0 ).a );
					const vec3 lum = vec3( 0.2126, 0.7152, 0.0722 ) * p.wet.z;
					const float wc = p.sky.w / ( 1.0 + dot( cur.rgb, lum ) ), wh = ( 1.0 - p.sky.w ) / ( 1.0 + dot( hist.rgb, lum ) );
					cur = ( hist * wh + cur * wc ) / ( wh + wc );
				}
			}
		}
	}
	imageStore( accumImg, id, vec4( cur.rgb, d ) );
	imageStore( aoImg, id, vec4( aoOut.rgb, cur.a ) );
}

void main()
{
	const ivec2 id = ivec2( gl_GlobalInvocationID.xy );
	const ivec2 size = imageSize( accumImg );
	if ( any( greaterThanEqual( id, size ) ) )
		return;
	const vec2 texel = 1.0 / vec2( size );
	const vec2 uv = ( vec2( id ) + 0.5 ) * texel;
	const float d = texelFetch( historyDepthTex, id, 0 )[kDepthChannel];
	const vec3 P = position( uv, d );
	if ( d <= 0.0 ) {
		imageStore( accumImg, id, vec4( 0.0 ) );
		if ( p.opts2.z > 0.5 || p.gloss.x > 0.5 )
			storeOcclusion( id, P, vec3( 0.0, 0.0, 1.0 ), d, false );
		return;
	}

	// the normal from the neighbours' depths: on each axis the side nearer in depth (not across an edge)
	// (a character's depth is stored negative: its depth still shapes the normal, as before the marks)
	const float dl = abs( texelFetch( historyDepthTex, clamp( id - ivec2( 1, 0 ), ivec2( 0 ), size - 1 ), 0 )[kDepthChannel] );
	const float dr = abs( texelFetch( historyDepthTex, clamp( id + ivec2( 1, 0 ), ivec2( 0 ), size - 1 ), 0 )[kDepthChannel] );
	const float du = abs( texelFetch( historyDepthTex, clamp( id - ivec2( 0, 1 ), ivec2( 0 ), size - 1 ), 0 )[kDepthChannel] );
	const float dd = abs( texelFetch( historyDepthTex, clamp( id + ivec2( 0, 1 ), ivec2( 0 ), size - 1 ), 0 )[kDepthChannel] );
	const vec3 px = abs( dr - d ) < abs( dl - d ) && dr > 0.0 ? position( uv + vec2( texel.x, 0.0 ), dr ) - P : P - position( uv - vec2( texel.x, 0.0 ), dl );
	const vec3 py = abs( dd - d ) < abs( du - d ) && dd > 0.0 ? position( uv + vec2( 0.0, texel.y ), dd ) - P : P - position( uv - vec2( 0.0, texel.y ), du );
	vec3 Ng = normalize( cross( py, px ) );
	const vec3 V = normalize( p.eye.xyz - P );
	if ( dot( Ng, V ) < 0.0 )
		Ng = -Ng;
	if ( p.opts2.z > 0.5 || p.gloss.x > 0.5 )
		storeOcclusion( id, P, Ng, d, true );
	// wet ground, and the water's band (a texel there may be water: scene.frag decides, by its material)
	const bool water = p.opts.w > 0.5 && P.z >= p.opts.y && P.z <= p.opts.z;
	if ( ( p.wet.x <= 0.0 && !water ) || Ng.z < 0.5 ) {
		if ( p.gloss.x > 0.5 )
			glossyTrace( id, P, Ng, V, d );
		else
			imageStore( accumImg, id, vec4( 0.0 ) );
		return;
	}
	// level ground: the half-size r16f depths round in steps, and a normal from neighbours' differences tilts row by row,
	// so the reflected rays fanned out per row and an upright mirrored as strips shifted sideways in stair-steps; past opts2.x it is taken as level
	if ( Ng.z > p.opts2.x )
		Ng = vec3( 0.0, 0.0, 1.0 );

	// glossy spread: wet ground at scene.frag's cap (WET_ROUGH: most pavement is rougher, so the cap is its roughness),
	// puddles 0.05, sampled a little differently every frame
	const vec2 q = P.xy / UNITS_PER_METRE;
	const vec2 rq = mat2( 0.8, 0.6, -0.6, 0.8 ) * q;
	const float n = gradientNoise( q / 4.0 ) * 0.6 + gradientNoise( rq / 1.5 + 17.0 ) * 0.3 + gradientNoise( q / 0.5 + 5.0 ) * 0.1;
	const float t = 1.0 - p.wet.y;
	const float wetRough = mix( WET_ROUGH, 0.05, p.wet.y > 0.0 ? smoothstep( t - 0.05, t + 0.05, n ) : 0.0 );
	const float rough = water ? WATER_ROUGH : wetRough;
	const float j1 = ign( vec2( id ), p.eye.w ), j2 = ign( vec2( id.yx ) + 31.0, p.eye.w ), j3 = ign( vec2( id ) + 67.0, p.eye.w + 13.0 );
	// last frame's result where the same surface was (its depth within 8%: grazing ground runs far in depth from one
	// texel to the next)
	vec4 hist = vec4( 0.0 );
	bool haveHist = false;
	if ( p.prevFwd.w > 0.5 ) {
		const vec4 c = p.prevViewProj * vec4( P, 1.0 );
		if ( c.w > 1.0 ) {
			const vec2 pu = c.xy / c.w * 0.5 + 0.5;
			if ( all( greaterThanEqual( pu, vec2( 0.0 ) ) ) && all( lessThanEqual( pu, vec2( 1.0 ) ) ) ) {
				const vec4 h = textureLod( prevAccumTex, pu, 0.0 );
				const float zp = dot( P - p.prevEye.xyz, p.prevFwd.xyz );
				if ( h.a > 0.0 && abs( h.a - zp ) < 0.08 * zp + 16.0 ) {
					hist = vec4( h.rgb, textureLod( prevAoTex, pu, 0.0 ).a );
					haveHist = true;
				}
			}
		}
	}

	// a surface with no history yet (just revealed, or the view moved fast) takes two rays: one alone showed as blotches;
	// with history r_sceneSsrRays (2 by default: one settled at 15% showed as a dither on the wet ground)
	// out as r_sceneSsrGlossy's: the hits' light premultiplied, their share in aoImg's a; scene.frag fills the rest from
	// its own sky (the water's, with its clouds) or the haze. A miss filled here took the haze at half or a quarter by
	// the screen edge the ray left through, so open water showed wedges from the screen's corners, and never its sky
	vec4 cur = vec4( 0.0 );
	const int rays = haveHist ? int( p.opts.x ) : 2;
	for ( int k = 0; k < rays; k++ ) {
		const vec3 jit = k == 0 ? vec3( j1, j2, j3 ) : fract( vec3( j1, j2, j3 ) + vec3( 0.5, 0.618, 0.382 ) );
		const vec3 spread = ( vec3( jit.y, jit.z, fract( jit.y + jit.z ) ) - 0.5 ) * ( rough * rough * 4.0 );
		const vec3 R = normalize( reflect( -V, Ng ) + spread );
		if ( R.z > 0.0 ) {
			float sky;
			vec4 hit = trace( P + Ng * 2.0, R, jit.x, rough * rough * 4.0, sky );
			// r_sceneWaterMirror: a miss's share takes the mirrored model where the ray meets it (in front of the sky)
			const vec4 m = hit.a < 1.0 ? mirrorProxy( P, R ) : vec4( 0.0 );
			if ( m.a > 0.0 )
				hit = vec4( hit.rgb * hit.a + m.rgb * ( 1.0 - hit.a ), 1.0 );
			if ( p.refl.x > 0.5 ) {	// (a miss: the area's baked reflection capture, where one is loaded)
				cur += vec4( hit.rgb * hit.a + reflSky( R, rough ) * ( 1.0 - hit.a ), 1.0 );
			} else {
				hit.rgb *= hit.a;
				if ( hit.a < 1.0 ) {
					const vec4 open = skyAlong( R );	// (the miss's share: the sky the frame shows that way)
					hit = vec4( hit.rgb + open.rgb * ( 1.0 - hit.a ), hit.a + open.a * ( 1.0 - hit.a ) );
				}
				cur += hit;
			}
		}
	}
	cur /= float( rays );

	// settle over frames, each side weighted down by its brightness (Karis 2014): a bright thin thing moving through the
	// mirror (a saber's blade) no longer sparkles in half-size blocks
	if ( haveHist ) {
		const vec3 lum = vec3( 0.2126, 0.7152, 0.0722 ) * p.wet.z;
		const float wc = p.sky.w / ( 1.0 + dot( cur.rgb, lum ) ), wh = ( 1.0 - p.sky.w ) / ( 1.0 + dot( hist.rgb, lum ) );
		cur = ( hist * wh + cur * wc ) / ( wh + wc );
	}
	imageStore( accumImg, id, vec4( cur.rgb, d ) );
	imageStore( aoImg, id, vec4( aoOut.rgb, cur.a ) );
}
