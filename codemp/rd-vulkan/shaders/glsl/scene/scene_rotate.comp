#version 450
// Render scenes (vk_scene.cpp, Scene_RotateFrame): CP2077's rotating meshes (maps/<map>.xrot: fans, propellers, the ad
// rings) turned in place in the instance buffer before the culls, one thread a rotating instance: its matrix is its
// placement M times the turn about its pivot p (axis a, angle phase + dt x speed): M [R | p - R p]. The phase is the
// slot's, folded by the host in double precision when its time base moved (every 20 s at most), so the float angle here
// stays small and as exact as the host's was.

layout(local_size_x = 64) in;

struct Rot { vec4 m0, m1, m2; vec4 pivotSpeed; vec4 axisInst; };	// M's rows; pivot, speed (rad/s); axis, the instance (bits)
struct Instance { vec4 r0, r1, r2; uvec4 info; };

layout(std430, set = 0, binding = 0) readonly buffer Rots { Rot rots[]; };
layout(std430, set = 0, binding = 1) readonly buffer Phases { float phase[]; };	// the slot's, at its time base
layout(std430, set = 0, binding = 2) buffer Instances { Instance inst[]; };

layout(push_constant) uniform Push {
	uvec4 p;	// x: the rotating instances
	vec4 t;		// x: seconds since the slot's time base (0: not turning, r_sceneRotate 0)
} pc;

const float TWO_PI = 6.28318530718;

void main()
{
	const uint k = gl_GlobalInvocationID.x;
	if ( k >= pc.p.x )
		return;
	const Rot q = rots[k];
	const float ang = mod( phase[k] + pc.t.x * q.pivotSpeed.w, TWO_PI );
	const float c = cos( ang ), sn = sin( ang ), C = 1.0 - c;
	const float x = q.axisInst.x, y = q.axisInst.y, z = q.axisInst.z;
	const vec3 R0 = vec3( c + x * x * C, x * y * C - z * sn, x * z * C + y * sn );
	const vec3 R1 = vec3( y * x * C + z * sn, c + y * y * C, y * z * C - x * sn );
	const vec3 R2 = vec3( z * x * C - y * sn, z * y * C + x * sn, c + z * z * C );
	const vec3 p = q.pivotSpeed.xyz;
	const vec3 b = p - vec3( dot( R0, p ), dot( R1, p ), dot( R2, p ) );
	const uint id = floatBitsToUint( q.axisInst.w );
	// row i of M times [R | b]: column j of R is (R0[j], R1[j], R2[j])
	const vec4 m[3] = vec4[3]( q.m0, q.m1, q.m2 );
	vec4 o[3];
	for ( int i = 0; i < 3; i++ ) {
		const vec3 mi = m[i].xyz;
		o[i] = vec4( mi.x * R0.x + mi.y * R1.x + mi.z * R2.x,
			mi.x * R0.y + mi.y * R1.y + mi.z * R2.y,
			mi.x * R0.z + mi.y * R1.z + mi.z * R2.z,
			dot( mi, b ) + m[i].w );
	}
	inst[id].r0 = o[0];
	inst[id].r1 = o[1];
	inst[id].r2 = o[2];
}
