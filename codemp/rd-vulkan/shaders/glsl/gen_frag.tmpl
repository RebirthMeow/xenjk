			float fmaShadow = 1.0;
		#if defined(USE_LIGHT_VECTOR)
			if ( ReviewFix( 128u ) && max( lightColor.r, max( lightColor.g, lightColor.b ) ) > 0.0 ) {
				const vec3 P = u_camera.viewOrigin.xyz - var_ViewDir.xyz;
				fmaShadow = ContactShadow( P, L, int( u_entity.directedLight.w + 0.5 ), 0.0 );
				if ( u_camera.charOccGridShare > 0.0 ) {
					const float dl = dot( lightColor, vec3( 0.2126, 0.7152, 0.0722 ) ) / M_PI;
					const float al = dot( ambientColor, vec3( 0.2126, 0.7152, 0.0722 ) );
