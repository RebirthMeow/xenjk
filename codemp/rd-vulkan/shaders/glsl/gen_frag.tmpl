#endif // !USE_CL1
#endif // !USE_TX1

#if !defined(USE_TX1) && !defined(USE_TX2)
	// set before the alpha test, whose coverage branch writes base.a
	base = color0;
#endif

#if defined(PER_PIXEL_LIGHTING)
	// FMA diffuse alpha carries rim/SSS data, not opacity. Opaque stages retain the
	// stage/entity alpha (including native fades); explicit alphaFunc stages keep
	// their original alpha test, shadow coverage and sample-mask behavior below.
	if ( ( material_mode & 96 ) != 0
#ifdef USE_ATEST
		&& alpha_test_func == 0
#endif
	) {
#ifdef USE_CL0_IDENT
		color0.a = identity_color;
#else
		color0.a = frag_color0.a;
#endif
		base.a = color0.a;
	}
#endif

#ifdef USE_ATEST
	// r_charSelfShadowHairMap (char_occluder 3): a strand adds its optical depth -ln(1 - alpha) and the depth moments
	// where it lies in front of the opaque body in the first self-shadow tile (whose depth view left the hair out);
	// alpha as filtered at the map's footprint, so coverage averages instead of hashing into a sparse pattern
	if ( char_occluder == 3 ) {
	#if defined(PER_PIXEL_LIGHTING)
		const vec4 tile = u_camera.selfShadowTile[0];
		const vec2 st = tile.xy + gl_FragCoord.xy * u_camera.hairMapTexel * tile.z;
		const float front = texture( sun_shadow_texture, vec4( st, 3.0, gl_FragCoord.z - 2e-4 ) );
		const float alpha = clamp( color0.a, 0.0, 0.98 ) * front;
		if ( alpha < 0.002 )
			discard;
		const float tau = -log( 1.0 - alpha );
		// on the RGBA16F map -1..1 of the tile's depth range (world-unit moments overflow half floats)
		const float d = ( gl_FragCoord.z - 0.5 ) * ( ReviewFix( 64u ) ? 2.0 : u_camera.selfShadowScale[0].y );
		out_color = vec4( tau, tau * d, tau * d * d, d );
		return;
	#else
		discard;
	#endif
	}
	// characters casting shadows (char_occluder 2): a hashed alpha test, so a strand blocks its alpha's share of the
	// light once the lookup filters it (the dithered alpha of the reference renders); a hash per texel and depth keeps
	// stacked strands independent
	if ( char_occluder == 2 && alpha_test_func == 3 ) {
	#if defined (USE_FOG) || defined(PER_PIXEL_LIGHTING) || defined(USE_LIGHT_VECTOR)
		if ( u_camera.hairMapDepthView > 0.5 )
			discard;	// r_charSelfShadowHairMap: the first tile's hair goes to the map only
	#endif
		uvec3 h = uvec3( uvec2( gl_FragCoord.xy ), floatBitsToUint( gl_FragCoord.z ) ) * 1664525u + 1013904223u;
		h.x += h.y * h.z; h.y += h.z * h.x; h.z += h.x * h.y;
		h ^= h >> 16u;
		h.x += h.y * h.z; h.y += h.z * h.x; h.z += h.x * h.y;
		// test switches: selfShadowHairGain scales the alpha, selfShadowHairLod0 = 1 reads it from the full-size texture
	#if defined (USE_FOG) || defined(PER_PIXEL_LIGHTING) || defined(USE_LIGHT_VECTOR)
		const float castAlpha = ( u_camera.selfShadowHairLod0 > 0.5 ? textureLod( texture0, texCoord0, 0.0 ).a * color0.a / max( tex0.a, 1e-4 ) : color0.a ) * u_camera.selfShadowHairGain;
	#else
		const float castAlpha = color0.a;
	#endif
		if ( castAlpha <= float( h.x ) * ( 1.0 / 4294967296.0 ) ) discard;
	} else
	if (alpha_to_coverage != 0) {
#ifdef USE_SAMPLE_MASK
		// r_g2SampleShading 2 (vk_pipelines.cpp: MSAA, Ghoul2, coverage spec 2, hardware alpha-to-coverage off): the
		// coverage that per-sample shading gives, worked out here and written as the sample mask, so the rest of the
		// shader (the lighting) runs once per pixel instead of once per sample. Per-sample shading put each sample
		// through CoverageAlpha's one-pixel ramp and alpha-to-coverage, which keeps a sample when its ramp value passes
		// that sample's dither threshold; so here: the ramp at each sample's texture coordinates (interpolateAtSample,
		// shifted like texCoord0: parallax, iris) against a threshold per sample index, spread over (0, 1) by the golden
		// ratio for any sample count. A single hard threshold instead broke the faintest strands into dots. The mip,
		// its boost (a quarter per level) and the ramp's width are the pixel's.
		// Strands thinner than a pixel (the map minified: mip above 0) cover the pixel by their filtered alpha, which
		// the ramp alone dropped whole below the test value (Tifa's brows vanished at every stage size); so a sample is
		// also kept by that alpha, fully from mip 1. The thresholds are offset per fragment (a hash of its depth), so
		// stacked strand layers cover independent samples and add up instead of all keeping the same ones
		{
			const vec2 gx = dFdx( texCoord0 ), gy = dFdy( texCoord0 );
			const float lod = max( textureQueryLod( texture0, texCoord0 ).x, 0.0 );
			const float boost = 1.0 + lod * 0.25;
			const float unresolved = clamp( lod, 0.0, 1.0 );
			const float layer = float( floatBitsToUint( gl_FragCoord.z ) * 2654435761u ) * ( 1.0 / 4294967296.0 );
			const float rampAlpha = ( alpha_test_func == 2 ? 1.0 - base.a : base.a ) * boost;
			const float rampScale = 1.0 / max( fwidth( rampAlpha ), 1e-4 );
			const float rampAt = alpha_test_func == 2 ? 1.0 - alpha_test_value : alpha_test_value;
			const vec2 tcShift = texCoord0 - frag_tex_coord0;
			int inMask = gl_SampleMaskIn[0], mask = 0;
			while ( inMask != 0 ) {
				const int s = findLSB( inMask );
				inMask &= inMask - 1;
				const float a = textureGrad( texture0, interpolateAtSample( frag_tex_coord0, s ) + tcShift, gx, gy ).a * frag_color0.a;
				bool keep;
				if ( alpha_test_func == 1 )
					keep = a > 0.0;
				else {
					const float oa = alpha_test_func == 2 ? 1.0 - a : a;
					keep = max( ( oa * boost - rampAt ) * rampScale + 0.5, oa * unresolved ) > fract( ( float( s ) + 0.5 ) * 0.6180340 + layer );
				}
				if ( keep )
					mask |= 1 << s;
			}
			if ( mask == 0 )
				discard;
			gl_SampleMask[0] = mask;
			base.a = 1.0;
		}
#else
#if !defined(USE_TX1) && !defined(USE_TX2)
		if ( alpha_to_coverage == 1 ) {
			// the old coverage of single-texture stages: base used to be set only after this block, so A2C took the
			// raw alpha; world foliage was tuned against that soft look and keeps it
		} else
#endif
		if (alpha_test_func == 1) {
			base.a =  base.a > 0.0 ? 1.0 : 0.0;
		} else if (alpha_test_func == 2) {
			base.a = alpha_to_coverage != 2 ? CorrectAlpha(alpha_test_value, 1.0 - base.a, texCoord0)
				: CoverageAlpha(1.0 - alpha_test_value, 1.0 - base.a, texCoord0);
		} else if (alpha_test_func == 3) {
			base.a = CoverageAlpha(alpha_test_value, base.a, texCoord0);
		}
	#if !defined(USE_FOG) && !( defined(PER_PIXEL_LIGHTING) && defined(USE_LIGHTMAP) && defined(USE_TX1) ) && ( defined(USE_LIGHT_VECTOR) || ( defined(PER_PIXEL_LIGHTING) && defined(USE_LIGHT_VERTEX) ) )
