		// layerRM the layers' roughness and metalness already weighted (applied to the ORM values below)
		float layerKeep = 1.0;
		vec2 layerRM = vec2( 0.0 );
		if ( layer_count > 0 ) {
			for ( int i = 0; i < layer_count; i++ ) {
				const vec3 uvl = vec3( texCoord0 * u_global.layerParams[i].x, float( i ) );
				const vec4 albedoRough = texture( layer_albedo_texture, uvl );
				const float metal = texture( layer_normal_texture, uvl ).b * u_global.layerParams[i].w;
				const float w = layerMask[i] * u_global.layerTint[i].a;
				// in linear-light mode the layer albedo and tint decode like the stage albedo
				const bool dec = linearLight;
				diffuse.rgb = mix( diffuse.rgb, ( dec ? SRGBToLinear( albedoRough.rgb ) : albedoRough.rgb )
					* ( dec ? SRGBToLinear( u_global.layerTint[i].rgb ) : u_global.layerTint[i].rgb ), w );
				layerRM = mix( layerRM, vec2( albedoRough.a * u_global.layerParams[i].z, metal ), w );
				layerKeep *= 1.0 - w;
			}
		}

		// tintMask: each channel multiplies the albedo by its colour where it is set
		if ( tint_set > -1 ) {
			const vec3 t = texture( tint_texture, texCoord0 ).rgb;
			const bool dec = linearLight;	// the tint colours decode in linear-light mode
			const vec3 t0 = dec ? SRGBToLinear( u_global.tintParams[0].rgb ) : u_global.tintParams[0].rgb;
			const vec3 t1 = dec ? SRGBToLinear( u_global.tintParams[1].rgb ) : u_global.tintParams[1].rgb;
			const vec3 t2 = dec ? SRGBToLinear( u_global.tintParams[2].rgb ) : u_global.tintParams[2].rgb;
