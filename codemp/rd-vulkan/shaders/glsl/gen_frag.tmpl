		#endif
			out_color = vec4( FmaColor( diffuse, texCoord0, normalize( var_Normal.xyz ), L, E, lightColor, ambientColor, fmaShadow ), base.a );
		} else {
		const bool linearLight = u_entity.ambientLight.w > 0.5;
		toonLinear = linearLight;
		if ( linearLight ) {
			diffuse.rgb = SRGBToLinear( diffuse.rgb );
			lightColor = SRGBToLinear( lightColor );
			ambientColor = SRGBToLinear( ambientColor );
		}

		// materialMask: R subsurface, G sheen, B hair shift, A detail weight; without one the normal map's blue in the
		// material masks (1 without a normal map) and full detail
		// the normal map, material mask and layer mask texels are read once here and CalcNormal takes them
		// (it read the same texels again)
		const vec4 normalTexel = normal_texture_set > -1 ? texture( normal_texture, texCoord0 ) : vec4( 0.5, 0.5, 1.0, 0.5 );
		vec4 matMask = vec4( 1.0 );
		if ( mask_set > -1 )
			matMask = texture( mask_texture, texCoord0 );
		else if ( material_mode != 0 && normal_texture_set > -1 )
