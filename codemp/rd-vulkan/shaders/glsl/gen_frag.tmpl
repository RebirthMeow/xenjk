	// Stage material features (material_mode bits, any combination). MaterialLight returns the light's reflectance
	// times its cosine term, replacing ( Fd + Fs ) * NL. The masks are the materialMask channels (R subsurface, G sheen,
	// B hair shift, A detail weight), or without one the stage normal map's blue in each (1 without a normal map).

	// skin: per-channel wrap diffuse, the scatter colour widening the terminator (red reaches furthest)
	// r_charSkinSoftNormals (test, camera skinSoftNormals): each channel's cosine moved toward the vertex normal's, red
	// furthest, so the stage normal map's pores and fine relief fade as light diffusing under the skin blurs them
	vec3 SubsurfaceDiffuse( in float NLraw, in vec3 L, in vec3 Fd, in float mask )
	{
		const vec3 w = u_global.subsurfaceParams.rgb * ( u_global.subsurfaceParams.w * mask );
		vec3 NLc = vec3( NLraw );
		if ( u_camera.skinSoftNormals > 0.0 )
			NLc = mix( NLc, vec3( dot( normalize( var_Normal.xyz ), L ) ), clamp( u_camera.skinSoftNormals * mask * vec3( 1.0, 0.5, 0.25 ), 0.0, 1.0 ) );
		// ( NL + w ) / ( 1 + w ) integrates to pi ( 1 + w ); / ( 1 + w )^2 keeps the albedo's energy
		const vec3 NLd = clamp( ( NLc + w ) / ( ( vec3( 1.0 ) + w ) * ( vec3( 1.0 ) + w ) ), 0.0, 1.0 );
		return Fd * NLd;
	}

	// Charlie sheen distribution (Estevez and Kulla 2017) with Neubelt's visibility
	vec3 SheenLobe( in float NH, in float NL, in float NE, in float mask )
	{
		const float a = max( u_global.sheenParams.w * u_global.sheenParams.w, 0.0049 );
		const float invA = 1.0 / a;
		const float sin2h = max( 1.0 - NH * NH, 0.0078125 );
		const float D = ( 2.0 + invA ) * pow( sin2h, invA * 0.5 ) / ( 2.0 * M_PI );
		const float V = 1.0 / ( 4.0 * ( NL + NE - NL * NE ) + 1e-4 );
		return u_global.sheenParams.rgb * ( mask * D * V );
	}

	// eye: the cornea's reflectance at normal incidence, from its index of refraction, times its strength
	float CorneaF0()
	{
		const float r = ( u_global.eyeCorneaParams.x - 1.0 ) / ( u_global.eyeCorneaParams.x + 1.0 );
		return r * r * u_global.eyeCorneaParams.z;
	}

	// eye: the cornea's perceptual roughness (at least 0.02). With a roughnessEncoding other than perceptual, the
	// eye keyword's corneaRoughness is read as GGX alpha like the stage's maps (metalpow: not metallic, so the same)
	float CorneaRoughness()
	{
		const float r = max( u_global.eyeCorneaParams.y, 0.02 );
		return roughness_encoding != 0 ? sqrt( r ) : r;
	}

	// eye: the smooth wet cornea over the whole eye, a GGX highlight on the geometric normal (the iris and sclera
	// detail under it keep the stage normal map), with its own cosine term
	vec3 CorneaSpecular( in vec3 L, in vec3 E )
	{
		const vec3 Ng = normalize( var_Normal.xyz );
		const vec3 H = normalize( L + E );
		const float NL = clamp( dot( Ng, L ), 0.0, 1.0 );
		const float NE = abs( dot( Ng, E ) ) + 1e-5;
		const float NH = clamp( dot( Ng, H ), 0.0, 1.0 );
		const float VH = clamp( dot( E, H ), 0.0, 1.0 );
		return CalcSpecular( vec3( CorneaF0() ), NH, NL, NE, 0.0, VH, CorneaRoughness() ) * NL;
	}

	// eye: where the iris (within eyeParams.x of the centre eyeParams.zw in texture space) is seen through the
	// cornea. The cornea's dome stands eyeParams.y (texture units) over the iris centre, falling to the limbus; the view
	// ray bends into it (ior eyeCorneaParams.x) and reaches the iris further along. Same tangent frame as parallax.
	vec2 EyeIrisOffset( in vec2 uv )
	{
		const float radius = max( u_global.eyeParams.x, 1e-4 );
		const float r = length( uv - u_global.eyeParams.zw );
		const float iris = 1.0 - smoothstep( radius - u_global.eyeCorneaParams.w, radius + u_global.eyeCorneaParams.w, r );
		const float height = u_global.eyeParams.y * max( 1.0 - ( r * r ) / ( radius * radius ), 0.0 );

		const vec3 T = var_Tangent.xyz;
		const vec3 Nv = var_Normal.xyz;
		const vec3 B = cross( Nv, T ) * var_Tangent.w;
		const vec3 V = normalize( vec3( dot( var_ViewDir.xyz, T ), dot( var_ViewDir.xyz, B ), dot( var_ViewDir.xyz, Nv ) ) );
		const vec3 R = refract( -V, vec3( 0.0, 0.0, 1.0 ), 1.0 / max( u_global.eyeCorneaParams.x, 1.0 ) );
		return R.xy / max( -R.z, 0.1 ) * ( height * iris );
	}

	// Kajiya-Kay strand highlights (Scheuermann 2004): a white primary lobe and an albedo-tinted secondary one,
	// along tangents shifted toward the normal; the per-pixel shift is mask - 0.5
	float StrandSpecular( in vec3 T, in vec3 H, in float exponent )
	{
		const float TH = dot( T, H );
		const float sinTH = sqrt( max( 1.0 - TH * TH, 0.0 ) );
		return smoothstep( -1.0, 0.0, TH ) * pow( sinTH, exponent );
	}

	vec3 HairSpecular( in vec3 N, in vec3 H, in vec3 albedo, in vec3 specular, in float mask )
	{
		vec3 T = u_global.hairParams.x < 0.5 ? var_Tangent.xyz : var_Tangent.w * cross( var_Normal.xyz, var_Tangent.xyz );
		T = normalize( T - N * dot( N, T ) + vec3( 1e-6 ) );
		const float shift = u_global.hairParams.y + ( mask - 0.5 );
		const vec3 T1 = normalize( T + N * ( shift - 0.05 ) );
		const vec3 T2 = normalize( T + N * ( shift + 0.1 ) );
		const float e1 = u_global.hairParams.z, e2 = u_global.hairParams.w;
		return specular * ( StrandSpecular( T1, H, e1 ) * ( e1 + 2.0 ) / ( 2.0 * M_PI ) )
			+ albedo * ( specular.g * StrandSpecular( T2, H, e2 ) * ( e2 + 2.0 ) / ( 2.0 * M_PI ) );
	}

	// toon (material_mode 16, r_toon): the main light (the grid's directed and ambient light together, toonMain)
	// moves the albedo from the shade colour to the lit one where its half-Lambert term, times its shadow
	// (toonShadow), crosses toonParams.x (toonParams.y either side); it keeps its colour and strength on both sides,
	// so the shade side is the shade colour in that light, not its absence. Every other light (dynamic lights, the
	// sun on top of the grid, the character fill and rim) adds the lit albedo on its own lit side only, by the same
	// step. toonShade / toonSkinShade are sRGB multipliers (toonLinear: lit in linear space).
	float toonShadow = 1.0;
	vec3 toonShadeTex = vec3( -1.0 );	// toonShadeMap's texel (toonLight.w 1; bound in the detailMap set), -1 none
	bool toonMain = false;
	bool toonLinear = false;

	// toon: a light's colour at toonLight.x share, the rest its luminance in grey (plain stages: unchanged)
	vec3 ToonLightColor( in vec3 c )
	{
		if ( ( material_mode & 16 ) == 0 )
			return c;
		return mix( vec3( dot( c, vec3( 0.2126, 0.7152, 0.0722 ) ) ), c, u_global.toonLight.x );
	}

	// toon: the stage's whole light (every light and reflection, as the colour's luminance over the albedo's) softly
	// compressed past toonLight.y, rising at most toonLight.z more: a cel character keeps its palette under the grid's
	// overbright light instead of washing out to white
	vec3 ToonExposure( in vec3 color, in vec3 albedo )
	{
		const vec3 lumW = vec3( 0.2126, 0.7152, 0.0722 );
		const float level = dot( color, lumW ) / max( dot( albedo, lumW ), 0.02 );
		const float knee = u_global.toonLight.y, over = level - knee;
		if ( over <= 0.0 )
			return color;
		return color * ( ( knee + over / ( 1.0 + over / max( u_global.toonLight.z, 1e-3 ) ) ) / level );
	}

	float ToonStep( in float NLraw )
	{
		const float x = ( NLraw * 0.5 + 0.5 ) * toonShadow;
		return smoothstep( u_global.toonParams.x - u_global.toonParams.y, u_global.toonParams.x + u_global.toonParams.y, x );
	}

	vec3 ToonShade( in vec3 albedo, in float skin )
	{
		if ( toonShadeTex.x >= 0.0 )
			return toonShadeTex;
		const vec3 m = mix( u_global.toonShade.rgb, u_global.toonSkinShade.rgb, clamp( skin, 0.0, 1.0 ) );
		return albedo * ( toonLinear ? pow( m, vec3( 2.2 ) ) : m );
	}

	// the stepped highlight on the lit side (t), where N.H passes 1 - size (toonShade.w soft): white on dielectrics,
	// the metal's own colour on metals (specular is F0), up to the strength at F0 0.04 and above
	vec3 ToonSpecular( in float NH, in float t, in vec3 specular )
	{
		if ( u_global.toonParams.z <= 0.0 )
			return vec3( 0.0 );
		const float m = max( specular.r, max( specular.g, specular.b ) );
		const float edge = 1.0 - u_global.toonParams.z;
		const float s = smoothstep( edge - u_global.toonShade.w, edge + u_global.toonShade.w, NH ) * t;
		return specular / max( m, 1e-4 ) * ( s * u_global.toonParams.w * clamp( m / 0.04, 0.0, 1.0 ) );
	}

	// r_charTerms test bits (characters lit in linear space): ambientLight.w = mode + 10 x bits
	int CharTerms()
	{
		return int( u_entity.ambientLight.w * 0.1 + 0.05 );
	}

	vec3 MaterialLight( in vec3 N, in vec3 L, in vec3 E, in float NE, in vec3 Fd, in vec3 Fs,
		in vec3 albedo, in vec3 specular, in vec4 masks )
	{
		const float NLraw = dot( N, L );
		const float NL = clamp( NLraw, 0.0, 1.0 );
		const vec3 H = normalize( L + E );
		const float NH = clamp( dot( N, H ), 0.0, 1.0 );

		const int terms = CharTerms();
		// toon: shade to lit by the step (the PI the caller's light carries divided out), a stepped highlight (strands
		// for hair, on the lit side); sheen and the cornea add as below
		if ( ( material_mode & 16 ) != 0 ) {
			const float t = ToonStep( NLraw );
			vec3 toon = ( toonMain ? mix( ToonShade( albedo, masks.r ), albedo, t ) : albedo * t ) * ( 1.0 / M_PI );
			if ( ( terms & 1 ) != 0 )
				return toon;
			if ( ( material_mode & 2 ) != 0 )
				toon += HairSpecular( N, H, albedo, specular, masks.b ) * ( NL * t );
			else
				toon += ToonSpecular( NH, t, specular ) * ( 1.0 / M_PI );
			if ( ( material_mode & 4 ) != 0 )
				toon += SheenLobe( NH, NL, NE, masks.g ) * NL;
			if ( ( material_mode & 8 ) != 0 )
				toon += CorneaSpecular( L, E );
			return toon;
		}

		// diffuse: wrapped for skin; specular: strands replace the GGX lobe for hair, sheen adds to either
		const vec3 diffuseLight = ( material_mode & 1 ) != 0 && ( terms & 4 ) == 0 ? SubsurfaceDiffuse( NLraw, L, Fd, masks.r ) : Fd * NL;
		if ( ( terms & 1 ) != 0 )
			return diffuseLight;
		vec3 specularLight = ( material_mode & 2 ) != 0 ? HairSpecular( N, H, albedo, specular, masks.b ) : Fs;
		if ( ( material_mode & 4 ) != 0 )
			specularLight += SheenLobe( NH, NL, NE, masks.g );
		vec3 result = diffuseLight + specularLight * NL;
		if ( ( material_mode & 8 ) != 0 )
			result += CorneaSpecular( L, E );
		return result;
	}

	// r_charFast (camera charFastBits) bits: look work skipped where it cannot change the image; off in the debug views
	int CharFast()
	{
		return ( DebugSelfShadow() > 0.5 || DebugOcclusion() > 0.5 ) ? 0 : int( u_camera.charFastBits + 0.5 );
	}

	// no light from L reaches the stage: MaterialLight's terms and the plain lit path all scale by the clamped N.L, except
	// skin's wrap (its widest channel past the terminator, on N or the vertex normal, r_charSkinSoftNormals) and the eye's
	// cornea (the vertex normal). Shadows toward L need not be looked up there.
	bool CharLightAway( in vec3 N, in vec3 L )
	{
		float reach = dot( N, L );
		if ( ( material_mode & 9 ) != 0 ) {
			const float g = dot( normalize( var_Normal.xyz ), L );
			if ( ( material_mode & 8 ) != 0 && g > 0.0 )
				return false;
			if ( ( material_mode & 1 ) != 0 ) {
				const vec3 w = u_global.subsurfaceParams.rgb * u_global.subsurfaceParams.w;
				if ( min( w.r, min( w.g, w.b ) ) < 0.0 )
					return false;
				reach = max( reach, g ) + max( w.r, max( w.g, w.b ) );
			}
		}
		return reach <= 0.0;
	}

	// r_charFill / r_charRim (models lit by the light grid): one extra directional light toward Lx, through the stage's
	// material model as the grid's own light (plain stages: albedo + GGX); the caller scales it by its colour x PI
	vec3 CharGridExtra( in vec3 Lx, in vec3 N, in vec3 E, in float NE, in vec3 albedo, in vec3 specular, in float roughness,
		in vec4 masks )
	{
		const vec3 H = normalize( Lx + E );
		const float NL = clamp( dot( N, Lx ), 0.0, 1.0 );
		const float LH = clamp( dot( Lx, H ), 0.0, 1.0 );
		const float NH = clamp( dot( N, H ), 0.0, 1.0 );
		const float VH = clamp( dot( E, H ), 0.0, 1.0 );
		const vec3 Fd = CalcDiffuse( albedo, NE, NL, LH, roughness );
		const vec3 Fs = CalcSpecular( specular, NH, NL, NE, LH, VH, roughness );
		if ( material_mode != 0 )
			return MaterialLight( N, Lx, E, NE, Fd, Fs, albedo, specular, masks );
		return ( Fd + ( ( CharTerms() & 1 ) != 0 ? vec3( 0.0 ) : Fs ) ) * NL;
	}

	// r_charLinear (characters: u_entity.ambientLight.w 1 linear, 2 linear + PBR Neutral): textures and baked light are
	// sRGB-encoded; light them in linear space as the research Cycles renders do, then encode back
	vec3 SRGBToLinear( in vec3 c )
	{
		return mix( c / 12.92, pow( ( c + 0.055 ) / 1.055, vec3( 2.4 ) ), step( vec3( 0.04045 ), c ) );
	}

	vec3 LinearToSRGB( in vec3 c )
	{
		return mix( c * 12.92, 1.055 * pow( c, vec3( 1.0 / 2.4 ) ) - 0.055, step( vec3( 0.0031308 ), c ) );
	}

	#include "common/fma.glsl"

	// Khronos PBR Neutral tone mapping (Blender's "Khronos PBR Neutral" view)
	vec3 PBRNeutral( in vec3 color )
	{
		const float startCompression = 0.8 - 0.04;
		const float desaturation = 0.15;
		const float x = min( color.r, min( color.g, color.b ) );
		const float offset = x < 0.08 ? x - 6.25 * x * x : 0.04;
		color -= offset;
		const float peak = max( color.r, max( color.g, color.b ) );
		if ( peak < startCompression )
			return color;
		const float d = 1.0 - startCompression;
		const float newPeak = 1.0 - d * d / ( peak + d - startCompression );
		color *= newPeak / peak;
		const float g = 1.0 - 1.0 / ( desaturation * ( peak - newPeak ) + 1.0 );
		return mix( color, vec3( newPeak ), g );
	}

	// r_charLinear 3 (camera charTone, R_SceneCharTone): a render scene's tone curve as scene.frag's toDisplay gives it
	// (r_sceneToneAdjust, the curve, the headroom past its top, gamma 2.2), so its grade (scene_grade.frag, which takes
	// the curve back off every pixel) gets back the light the character was lit with; the light came after exposure
	const float SC_TONE_TOP = 0.999, SC_TONE_LOG = 0.1;
	vec3 scAcesFit( vec3 c ) { return clamp( ( c * ( 2.51 * c + 0.03 ) ) / ( c * ( 2.43 * c + 0.59 ) + 0.14 ), 0.0, 1.0 ); }
	float scGt7Curve( const float x )
	{
		if ( x <= 0.0 )
			return 0.0;
		if ( x < 0.444 ) {
			const float wl = smoothstep( 0.0, 0.538, x );
			return ( 1.0 - wl ) * 0.538 * pow( x / 0.538, 1.28 ) + wl * x;
		}
		return min( 1.185333 - 1.349340 * exp( x * -1.348921 ), 1.0 );
	}
	float scGt7PQ( const float v )
	{
		const float ym = pow( max( v * 0.01, 0.0 ), 0.1593017578125 );
		return pow( ( 0.8359375 + 18.8515625 * ym ) / ( 1.0 + 18.6875 * ym ), 78.84375 );
	}
	float scGt7PQInverse( const float n )
	{
		const float np = pow( clamp( n, 0.0, 1.0 ), 1.0 / 78.84375 );
		return pow( max( np - 0.8359375, 0.0 ) / ( 18.8515625 - 18.6875 * np ), 1.0 / 0.1593017578125 ) * 100.0;
	}
	vec3 scGt7ICtCp( const vec3 c )
	{
		const float l = scGt7PQ( dot( c, vec3( 1688.0, 2146.0, 262.0 ) ) / 4096.0 );
		const float m = scGt7PQ( dot( c, vec3( 683.0, 2951.0, 462.0 ) ) / 4096.0 );
		const float s = scGt7PQ( dot( c, vec3( 99.0, 309.0, 3688.0 ) ) / 4096.0 );
		return vec3( 0.5 * ( l + m ), ( 6610.0 * l - 13613.0 * m + 7003.0 * s ) / 4096.0, ( 17933.0 * l - 17390.0 * m - 543.0 * s ) / 4096.0 );
	}
	vec3 scGt7ICtCpInverse( const vec3 i )
	{
		const float l = scGt7PQInverse( i.x + 0.00860904 * i.y + 0.11103 * i.z );
		const float m = scGt7PQInverse( i.x - 0.00860904 * i.y - 0.11103 * i.z );
		const float s = scGt7PQInverse( i.x + 0.560031 * i.y - 0.320627 * i.z );
		return max( vec3( 3.43661 * l - 2.50645 * m + 0.0698454 * s, -0.79133 * l + 1.9836 * m - 0.192271 * s,
			-0.0259499 * l - 0.0989137 * m + 1.12486 * s ), vec3( 0.0 ) );
	}
	vec3 scToneCurve( vec3 c, const float mode )
	{
		if ( mode > 2.5 ) {
			const vec3 skew = vec3( scGt7Curve( c.r ), scGt7Curve( c.g ), scGt7Curve( c.b ) );
			const vec3 u = scGt7ICtCp( max( c, vec3( 0.0 ) ) ), su = scGt7ICtCp( skew );
			const float chroma = 1.0 - smoothstep( 0.98, 1.16, u.x / scGt7ICtCp( vec3( 1.0 ) ).x );
			c = min( mix( skew, scGt7ICtCpInverse( vec3( su.x, u.yz * chroma ) ), 0.6 ), vec3( 1.0 ) );
		} else if ( mode > 0.5 ) {
			const vec3 p = scAcesFit( c );
			const float share = clamp( ( mode - 1.0 ) * 2.0, 0.0, 1.0 );
			if ( share > 0.0 ) {
				const float L = max( dot( c, vec3( 0.2126, 0.7152, 0.0722 ) ), 1e-6 );
				const vec3 h = clamp( c * ( scAcesFit( vec3( L ) ).x / L ), 0.0, 1.0 );
				c = mix( p, h, share * ( 1.0 - smoothstep( 0.1, 0.8, L ) ) );
			} else {
				c = p;
			}
		} else {
			c = vec3( 1.0 ) - exp( -c );
		}
		return pow( c, vec3( 1.0 / 2.2 ) );
	}
	float scToneTop( const float mode )	// toneInverse( TONE_TOP )
	{
		const float y = pow( SC_TONE_TOP, 2.2 );
		if ( mode > 2.5 )
			return log( max( ( min( y, 0.99999 ) - 1.185333 ) / -1.349340, 1e-6 ) ) / -1.348921;
		if ( mode > 0.5 ) {
			const float a = 2.51 - 2.43 * y, b = 0.03 - 0.59 * y, c = -0.14 * y;
			return ( -b + sqrt( b * b - 4.0 * a * c ) ) / ( 2.0 * a );
		}
		return -log( 1.0 - y );
	}
	vec3 SceneToneDisplay( vec3 c )
	{
		const float mode = u_camera.charTone.x - 1.0;
		if ( u_camera.charTone.z > 0.0 )
			c = pow( max( c * u_camera.charTone.y, vec3( 0.0 ) ), vec3( 1.0 / u_camera.charTone.z ) );
		const float top = scToneTop( mode );
		return mix( scToneCurve( c, mode ), SC_TONE_TOP + SC_TONE_LOG * log( max( c, vec3( 1e-6 ) ) / top ), greaterThan( c, vec3( top ) ) );
	}

	// character occlusion (r_charAO, r_charContactShadows; vk_charocc.cpp RB_CharOcclusion): the opaque depth prepass's
	// ambient occlusion and linear depth, screen-sized; white when the view did not compute them (charOccParams 0)
	layout (set = VK_DESC_MATERIAL,	binding = VK_MAT_SCREEN_AO) uniform sampler2D screen_ao_texture;
	layout (set = VK_DESC_MATERIAL,	binding = VK_MAT_SCREEN_DEPTH) uniform sampler2D screen_depth_texture;

	float dbgContactDlight = 1.0;	// r_charOcclusionDebug 3: the first dynamic light's contact shadow

	// r: AO; g, b, a: r_charContactShadows' blurred masks for the lights given channels 1..3
	vec4 ScreenOcclusion()
	{
		return textureLod( screen_ao_texture, gl_FragCoord.xy / vec2( textureSize( screen_depth_texture, 0 ) ), 0.0 );
	}

	float ScreenAO()
	{
		return ScreenOcclusion().r;
	}

	// eye-space point to the prepass depth's uv (projection x/y rows; the framebuffer's y runs down)
	vec2 ScreenUV( in vec3 Q )
	{
		const vec2 ndc = vec2( Q.x * u_camera.charOccProj.x + Q.z * u_camera.charOccProj.z + u_camera.charOccInfo.y,
			Q.y * u_camera.charOccProj.y + Q.z * u_camera.charOccProj.w + u_camera.charOccInfo.z ) / -Q.z;
		return vec2( 0.5 + 0.5 * ndc.x, 0.5 - 0.5 * ndc.y );
	}

	// screen-space contact shadow toward L (world, normalised) from the world point P: charOccParams.w steps along a
	// ray of charOccParams.y units, each looked up in the prepass's linear depth; a step behind the stored surface by
	// more than a small bias and less than the assumed thickness (z) is blocked. Soft ramps on both depth edges, faded
	// along the ray, interleaved-gradient jitter between steps. 1 = lit.
	// hair and lashes (alpha-tested stages) receive from full-resolution rays that also meet the other strands (the
	// depth's g, partly opaque); the half-resolution masks cannot see between strands
#ifdef USE_ATEST
	const bool stageAlphaTested = alpha_test_func != 0;
#else
	const bool stageAlphaTested = false;
#endif

	// simulated garment cloth (marked by vk_cloth.cpp, passed in var_Normal.w): fabric, not strands. It takes no
	// character self-shadow (a short-range term for faces and hair: on big folds it left hard-edged pieces of shadow)
	// and, where alpha-tested (lace edges), no contact shadow either: such stages are not in the depth
	// prepass, so the depth they would trace is the body behind them
#if defined(USE_LIGHT_VECTOR)
	bool SimCloth()
	{
		return var_Normal.w > 0.5;
	}
#else
	#define SimCloth() false
#endif

	// hairReach: how far along the ray strands count (u; 0 = not at all)
	float ContactShadowRay( in vec3 P, in vec3 L, in float len, in float size, in float hairReach )
	{
		const float hairOpacity = hairReach > 0.0 ? u_camera.charOccHairOpacity : 0.0;
		const int steps = int( u_camera.charOccParams.w );
		const float thick = u_camera.charOccParams.z;
		const vec3 Ng = normalize( var_Normal.xyz );
		// light grazing the surface: little of it to block, and the ray meets the surface's own facets; fade it out
		const float nlFade = smoothstep( 0.02, 0.15, dot( Ng, L ) );
		const vec3 Pv = ( u_camera.viewMatrix * vec4( P + Ng * 0.05, 1.0 ) ).xyz;
		const float jitter = fract( 52.9829189 * fract( dot( gl_FragCoord.xy, vec2( 0.06711056, 0.00583715 ) ) ) );
		// a light of charOccInfo.w radians across: the ray leans within that cone (a second noise, rotated per pixel)
		vec3 Lw = L;
		if ( size > 0.0 ) {
			const float a = 6.2831853 * fract( jitter * 1.618034 + 0.5 * fract( 0.7548777 * gl_FragCoord.y + 0.5698403 * gl_FragCoord.x ) );
			const vec3 t = normalize( cross( L, abs( L.z ) < 0.9 ? vec3( 0.0, 0.0, 1.0 ) : vec3( 1.0, 0.0, 0.0 ) ) );
			const vec3 b = cross( L, t );
			const float r = tan( 0.5 * size ) * sqrt( fract( jitter + 0.381966 ) );
			Lw = normalize( L + ( t * cos( a ) + b * sin( a ) ) * r );
		}
		const vec3 Lv = mat3( u_camera.viewMatrix ) * Lw;
		float shadow = 0.0;
		for ( int i = 0; i < steps; i++ ) {
			const float t = ( float( i ) + jitter ) / float( steps );
			const vec3 Q = Pv + Lv * ( t * len );
			if ( Q.z > -0.1 )
				break;
			const vec2 uv = ScreenUV( Q );
			if ( any( lessThan( uv, vec2( 0.0 ) ) ) || any( greaterThan( uv, vec2( 1.0 ) ) ) )
				break;
			vec2 sd = textureLod( screen_depth_texture, uv, 0.0 ).rg;
			// g holds every strand (drawn without a depth test): those behind the opaque surface are hidden
			if ( sd.x != 0.0 && sd.y >= abs( sd.x ) - 0.05 )
				sd.y = 1e9;
			const vec2 delta = vec2( -Q.z ) - vec2( abs( sd.x ), sd.y );
			const float fade = 1.0 - t * t;
			if ( sd.x != 0.0 )
				shadow = max( shadow, smoothstep( 0.02, 0.15, delta.x ) * ( 1.0 - smoothstep( thick * 0.5, thick, delta.x ) ) * fade );
			if ( hairOpacity > 0.0 && sd.y < 1e8 && t * len <= hairReach )
				shadow = max( shadow, hairOpacity * smoothstep( 0.02, 0.15, delta.y ) * ( 1.0 - smoothstep( thick * 0.5, thick, delta.y ) ) * fade );
		}
		// (hair cards' normals say little about the strands: no fade there)
		return 1.0 - shadow * ( stageAlphaTested ? 1.0 : nlFade );
	}

	// the 2x2 quad's mean of v (fine derivatives: each pixel reads its row and column neighbour); call in uniform
	// control flow
	float QuadMean( in float v )
	{
		const vec2 side = vec2( ( int( gl_FragCoord.x ) & 1 ) == 0 ? 1.0 : -1.0, ( int( gl_FragCoord.y ) & 1 ) == 0 ? 1.0 : -1.0 );
		const float row = 0.5 * ( v + v + dFdxFine( v ) * side.x );
		return 0.5 * ( row + row + dFdyFine( row ) * side.y );
	}

	// contact shadow toward L: the screen mask's channel (1..3) when the light has one, else traced here and averaged
	// over the pixel quad (the per-pixel jitter is decorrelated within it); call in uniform control flow
	float ContactShadow( in vec3 P, in vec3 L, in int channel, in float size )
	{
		if ( u_camera.charOccParams.y <= 0.0 )
			return 1.0;
		const float s = size > 0.0 ? size : u_camera.charOccInfo.w;
		// alpha-tested simulated cloth: none (a quad all of cloth leaves now; a mixed quad still traces, for QuadMean)
#if defined(USE_LIGHT_VECTOR)
		const float simQuad = stageAlphaTested ? QuadMean( SimCloth() ? 1.0 : 0.0 ) : 0.0;
		if ( simQuad > 0.99 )
			return 1.0;
#endif
		if ( channel > 0 && !stageAlphaTested ) {
			const float mask = ScreenOcclusion()[channel];
			// the short fine ray also meets lashes and strands lying on the skin (within 0.75 u, full resolution)
			return u_camera.charOccFine > 0.0 ? min( mask, QuadMean( ContactShadowRay( P, L, u_camera.charOccFine, s, 0.75 ) ) ) : mask;
		}
#if defined(USE_LIGHT_VECTOR)
		const float traced = QuadMean( ContactShadowRay( P, L, u_camera.charOccParams.y, s, stageAlphaTested ? u_camera.charOccParams.y : 0.0 ) );
		return stageAlphaTested && SimCloth() ? 1.0 : traced;
#else
		return QuadMean( ContactShadowRay( P, L, u_camera.charOccParams.y, s, stageAlphaTested ? u_camera.charOccParams.y : 0.0 ) );
#endif
	}

#ifdef VK_DLIGHT_GPU
	// dynamic lights on a material stage: the stage's features (skin wrap, hair strands, sheen, cornea) as for the
	// light grid's light, with its PI scale (CalcDynamicLightContribution adds plain albedo + GGX)
	vec3 CalcDynamicLightMaterial( in float roughness, in vec3 N, in vec3 E, in vec3 position, in float NE,
		in vec3 albedo, in vec3 specular, in vec4 masks )
	{
		vec3 outColor = vec3( 0.0 );
		for ( int i = 0; i < u_lights.num_lights; i++ ) {
			const vkUniformLightEntry_t light = u_lights.light[i];
			vec3 L = light.origin.xyz - position;
			const float sqrLightDist = dot( L, L );
			// r_charContactShadows: blocked by the prepass depth toward this light (before the range tests: the quad
			// mean needs every pixel of the quad here)
			// origin.w: 1 + mask channel (0 none) + 4 x the light's size in degrees
			const vec3 Ln = L * inversesqrt( max( sqrLightDist, 1e-6 ) );
			// r_charFast 1: no pixel of the quad takes this light (out of range, faded out or facing away), so none of the
			// quad's rays counts; the vote keeps the branch uniform over the quad
			bool skipContact = false;
			if ( ( CharFast() & 1 ) != 0 ) {
				const bool lit = sqrLightDist <= light.radius * light.radius
					&& CalcLightAttenuation( light.radius * light.radius / sqrLightDist ) >= 0.001 && !CharLightAway( N, Ln );
				skipContact = QuadMean( lit ? 1.0 : 0.0 ) == 0.0;
			}
			float contact = 1.0;
			if ( !skipContact )
				contact = ContactShadow( position, Ln, DlightContactChannel( light.origin.w ), DlightSize( light.origin.w ) );
			if ( i == 0 )
				dbgContactDlight = contact;
			if ( sqrLightDist > light.radius * light.radius )
				continue;
			const float attenuation = CalcLightAttenuation( light.radius * light.radius / sqrLightDist );
			if ( attenuation < 0.001 )
				continue;
			L /= sqrt( sqrLightDist );
			const vec3 H = normalize( L + E );
			const float NL = clamp( dot( N, L ), 0.0, 1.0 );
			const float LH = clamp( dot( L, H ), 0.0, 1.0 );
			const float NH = clamp( dot( N, H ), 0.0, 1.0 );
			const float VH = clamp( dot( E, H ), 0.0, 1.0 );
			outColor += ToonLightColor( light.color ) * ( M_PI * attenuation * contact ) * MaterialLight( N, L, E, NE, CalcDiffuse( albedo, NE, NL, LH, roughness ),
				CalcSpecular( specular, NH, NL, NE, LH, VH, roughness ), albedo, specular, masks );
		}
		return outColor;
	}
#endif

	// rend2's sun shadow lookup (lightall.glsl PCF/sunShadow): three cascades, hardware comparison with linear
	// filtering, rotated taps. The cascade matrices are the ones the cascades were drawn with (Vulkan clip space:
	// depth already 0..1, y already flipped), so only x/y are remapped to texture space.
	layout (set = VK_DESC_MATERIAL, binding = VK_MAT_SUN_SHADOW) uniform sampler2DArrayShadow sun_shadow_texture;
	// r_charSelfShadowHairMap (vk_sunshadow.cpp): the first self-shadow tile's hair, r = optical depth, g, b = its depth
	// moments (world units about the tile's centre), a = nearest strand; black when there is none
	layout (set = VK_DESC_MATERIAL, binding = VK_MAT_HAIR_MAP) uniform sampler2D hair_map_texture;

	float sunRandom( const vec2 p )
	{
		const vec2 r = vec2( 23.1406926327792690, 2.6651441426902251 );
		return fract( cos( mod( 123456789.0, 1e-7 + 256.0 * dot( p, r ) ) ) );
	}

	float sunPCF( const float layer, const vec2 st, const float dist, float PCFScale )
	{
		float mult;
		float scale = PCFScale / u_camera.sunShadowParams.y;
		float r = sunRandom( gl_FragCoord.xy ) * 6.2831853;	// a full turn, as the character shadow lookups
		float sinr = sin( r );
		float cosr = cos( r );
		mat2 rmat = mat2( cosr, sinr, -sinr, cosr ) * scale;
		const int filterMode = int( u_camera.sunShadowParams.w );

		if ( filterMode >= 1 ) {
			mult =  texture( sun_shadow_texture, vec4( st + rmat * vec2( -0.7055767, 0.196515 ), layer, dist ) );
			mult += texture( sun_shadow_texture, vec4( st + rmat * vec2( 0.3524343, -0.7791386 ), layer, dist ) );
			mult += texture( sun_shadow_texture, vec4( st + rmat * vec2( 0.2391056, 0.9189604 ), layer, dist ) );
			if ( filterMode >= 2 ) {
				mult += texture( sun_shadow_texture, vec4( st + rmat * vec2( -0.07580382, -0.09224417 ), layer, dist ) );
				mult += texture( sun_shadow_texture, vec4( st + rmat * vec2( 0.5784913, -0.002528916 ), layer, dist ) );
				mult += texture( sun_shadow_texture, vec4( st + rmat * vec2( 0.192888, 0.4064181 ), layer, dist ) );
				mult += texture( sun_shadow_texture, vec4( st + rmat * vec2( -0.6335801, -0.5247476 ), layer, dist ) );
				mult += texture( sun_shadow_texture, vec4( st + rmat * vec2( -0.5579782, 0.7491854 ), layer, dist ) );
				mult += texture( sun_shadow_texture, vec4( st + rmat * vec2( 0.7320465, 0.6317794 ), layer, dist ) );
				mult *= 0.11111;
			} else {
				mult *= 0.33333;
			}
		} else {
			const vec2 poissonDisk[16] = vec2[16](
				vec2( -0.94201624, -0.39906216 ), vec2( 0.94558609, -0.76890725 ),
				vec2( -0.094184101, -0.92938870 ), vec2( 0.34495938, 0.29387760 ),
				vec2( -0.91588581, 0.45771432 ), vec2( -0.81544232, -0.87912464 ),
				vec2( -0.38277543, 0.27676845 ), vec2( 0.97484398, 0.75648379 ),
				vec2( 0.44323325, -0.97511554 ), vec2( 0.53742981, -0.47373420 ),
				vec2( -0.26496911, -0.41893023 ), vec2( 0.79197514, 0.19090188 ),
				vec2( -0.24188840, 0.99706507 ), vec2( -0.81409955, 0.91437590 ),
				vec2( 0.19984126, 0.78641367 ), vec2( 0.14383161, -0.14100790 ) );
			mult = texture( sun_shadow_texture, vec4( st, layer, dist ) );
			for ( int i = 0; i < 16; i++ )
				mult += texture( sun_shadow_texture, vec4( st + rmat * poissonDisk[i], layer, dist ) );
			mult *= 1.0 / 17.0;
		}
		return mult;
	}

	vec3 sunShadowCoord( const mat4 m, const vec4 pos )
	{
		vec4 c = m * pos;
		c.xyz /= c.w;
		return vec3( c.xy * 0.5 + 0.5, c.z );
	}

	// rend2's parallax (lightall.glsl RayIntersectDisplaceMap / GetParallaxOffset, perf/rend2 r_parallaxFast). The
	// normal-height texture's view puts the height (alpha) in .r; rend2 flips it to depth at upload
	// (tr_image.cpp:3070), here the lookup flips it.
	float parallaxDepthAt( const vec2 uv, const vec2 dx, const vec2 dy )
	{
		return 1.0 - textureGrad( normal_texture, uv, dx, dy ).r;
	}

	float RayIntersectDisplaceMap( in vec2 inDp, in vec2 ds, in float parallaxBias,
		in vec2 dx, in vec2 dy, in int linearSearchSteps, in int binarySearchSteps )
	{
		vec2 dp = fract( inDp - parallaxBias * ds );

		// current size of search window
		float size = 1.0 / float( linearSearchSteps );

		// current depth position
		float depth = 0.0;

		// best match found (starts with last position 1.0)
		float bestDepth = 1.0;

		// try sampling at least one border pixel
		vec2 tMin = ( vec2( 0.0 ) - dp ) / ds;
		vec2 tMax = ( vec2( 1.0 ) - dp ) / ds;
		vec2 t = max( tMin, tMax );
		float tExit = min( t.x, t.y );
		float stepFraction = fract( tExit / size ) * size;
		depth -= size - stepFraction;

		// search front to back for first point inside object
		for ( int i = 0; i < linearSearchSteps; ++i )
		{
			depth += size;
			if ( depth >= parallaxDepthAt( dp + ds * depth, dx, dy ) )
			{
				bestDepth = depth;	// store best depth
				break;
			}
		}

		depth = bestDepth;

		// recurse around first point (depth) for closest match
		for ( int i = 0; i < binarySearchSteps; ++i )
		{
			size *= 0.5;
			if ( depth >= parallaxDepthAt( dp + ds * depth, dx, dy ) )
			{
				bestDepth = depth;
				depth -= 2.0 * size;
			}
			depth += size;
		}

		float beforeDepth = parallaxDepthAt( dp + ds * ( depth - size ), dx, dy ) - depth + size;
		float afterDepth  = parallaxDepthAt( dp + ds * depth, dx, dy ) - depth;
		float deltaDepth = beforeDepth - afterDepth;
		float weight = deltaDepth > 0.0 ? beforeDepth / deltaDepth : 0.0;
		bestDepth += weight * size;

		return bestDepth - parallaxBias;
	}

	vec2 GetParallaxOffset( in vec2 texCoords )
	{
		// tangent-space view direction (rend2 computes it per vertex), with rend2's correction for non-square maps
		vec3 T = var_Tangent.xyz;
		vec3 Nv = var_Normal.xyz;
		vec3 B = cross( Nv, T ) * var_Tangent.w;
		vec3 tangentDir = vec3( dot( var_ViewDir.xyz, T ), dot( var_ViewDir.xyz, B ), dot( var_ViewDir.xyz, Nv ) );
		vec2 normalSize = vec2( textureSize( normal_texture, 0 ) );
		float normalMapAspect = normalSize.y / normalSize.x;
		tangentDir *= vec3( max( 1.0, normalMapAspect ), max( 1.0, 1.0 / normalMapAspect ), 1.0 );

		vec3 offsetDir = normalize( tangentDir );
		offsetDir.xy *= -u_global.normalScale.a / offsetDir.z;
		// gradients before any branch: derivatives are undefined in divergent control flow
		vec2 dx = dFdx( texCoords );
		vec2 dy = dFdy( texCoords );

		if ( normal_texture_set == 1 || normal_texture_set == 3 ) {
			// r_parallaxFast: the deepest point shifts the texture by length(offsetDir.xy) in UV. Below about one
			// screen pixel parallax cannot show: fade it out there and skip the search. Where it shows, about one
			// linear step per two pixels of shift.
			float uvPerPixel = max( length( dx ), length( dy ) );
			float shiftPx = length( offsetDir.xy ) / max( uvPerPixel, 1e-9 );
			float fade = smoothstep( 0.5, 1.5, shiftPx );
			if ( fade <= 0.0 )
				return vec2( 0.0 );
			int linearSteps = int( clamp( ceil( shiftPx * 0.5 ), 4.0, 16.0 ) );
			return fade * offsetDir.xy * RayIntersectDisplaceMap( texCoords, offsetDir.xy, u_global.parallaxBias,
				dx, dy, linearSteps, 5 );
		}
		return offsetDir.xy * RayIntersectDisplaceMap( texCoords, offsetDir.xy, u_global.parallaxBias, dx, dy, 16, 8 );
	}

	float sunShadow( in vec3 viewOrigin, in vec3 viewDir, in vec3 biasOffset )
	{
		vec4 biasPos = vec4( viewOrigin - viewDir + biasOffset, 1.0 );
		float cameraDistance = length( viewDir );
		const float PCFScale = 1.5;
		const float edgeBias = 0.5 - ( 4.0 * PCFScale / u_camera.sunShadowParams.y );
		float edgefactor = 0.0;
		float result = 1.0;

		vec3 shadowpos = sunShadowCoord( u_camera.sunShadowMvp0, biasPos );
		if ( all( lessThanEqual( abs( shadowpos - vec3( 0.5 ) ), vec3( edgeBias ) ) ) )
		{
			vec3 dCoords = smoothstep( 0.3, 0.45, abs( shadowpos - vec3( 0.5 ) ) );
			edgefactor = 2.0 * PCFScale * clamp( dCoords.x + dCoords.y + dCoords.z, 0.0, 1.0 );
			result = sunPCF( 0.0, shadowpos.xy, shadowpos.z, PCFScale + edgefactor );
		}
		else
		{
			shadowpos = sunShadowCoord( u_camera.sunShadowMvp1, biasPos + vec4( biasOffset, 0.0 ) );
			if ( all( lessThanEqual( abs( shadowpos - vec3( 0.5 ) ), vec3( edgeBias ) ) ) )
			{
				vec3 dCoords = smoothstep( 0.3, 0.45, abs( shadowpos - vec3( 0.5 ) ) );
				edgefactor = 0.5 * PCFScale * clamp( dCoords.x + dCoords.y + dCoords.z, 0.0, 1.0 );
				result = sunPCF( 1.0, shadowpos.xy, shadowpos.z, PCFScale + edgefactor );
			}
			else
			{
				shadowpos = sunShadowCoord( u_camera.sunShadowMvp2, biasPos + vec4( biasOffset, 0.0 ) );
				// inside the layer only (rend2 accepted -0.5..1.5 and read clamped edge texels); the last cascade's
				// box encloses its whole view slice, so nothing in range falls outside
				if ( all( lessThanEqual( abs( shadowpos - vec3( 0.5 ) ), vec3( 0.5 ) ) ) )
				{
					result = sunPCF( 2.0, shadowpos.xy, shadowpos.z, PCFScale );
					float fade = clamp( cameraDistance / u_camera.sunShadowParams.z * 10.0 - 9.0, 0.0, 1.0 );
					result = mix( result, 1.0, fade );
				}
			}
		}
		return result;
	}

	// character shadows (tr_charshadow.cpp R_SetupCharShadows): the share of the baked light kept at P. Each caster's tile
	// in layer 3 holds its depth along its light; a receiver behind it loses occlusion x NL / ( ambient / directed + NL )
	// of its light, NL its facing to that light. Fades out over the last 40% of the reach behind the caster.
	// Contact hardening (r_charShadowLightSize): 8 taps find the blockers over the widest penumbra the receiver can
	// have, each blocker's depth found by bisection with the comparison sampler (the layer has no raw-depth view);
	// the filter's radius is then the mean blocker's distance x tan( size / 2 ), at least r_charShadowSoftness texels.
	const vec2 charDisk8[8] = vec2[8](
		vec2( 0.2, 0.0 ), vec2( 0.0, 0.45 ), vec2( -0.65, 0.0 ), vec2( 0.0, -0.8 ),
		vec2( 0.7, 0.7 ), vec2( -0.5, 0.5 ), vec2( -0.35, -0.35 ), vec2( 0.6, -0.6 ) );
	const vec2 charDisk16[16] = vec2[16](
		vec2( -0.94201624, -0.39906216 ), vec2( 0.94558609, -0.76890725 ),
		vec2( -0.094184101, -0.92938870 ), vec2( 0.34495938, 0.29387760 ),
		vec2( -0.91588581, 0.45771432 ), vec2( -0.81544232, -0.87912464 ),
		vec2( -0.38277543, 0.27676845 ), vec2( 0.97484398, 0.75648379 ),
		vec2( 0.44323325, -0.97511554 ), vec2( 0.53742981, -0.47373420 ),
		vec2( -0.26496911, -0.41893023 ), vec2( 0.79197514, 0.19090188 ),
		vec2( -0.24188840, 0.99706507 ), vec2( -0.81409955, 0.91437590 ),
		vec2( 0.19984126, 0.78641367 ), vec2( 0.14383161, -0.14100790 ) );
	// r_charShadowDebug 3 / 4: tiles covering the pixel and the deepest centre-tap occlusion; the stored depth
	// of the first covering tile, bracketed (r/g/b = stored >= 0.1 / 0.4 / 0.7)
	float charDbgCover = 0.0, charDbgOcclusion = 0.0, charDbgDistance = -1.0;
	vec3 charDbgStored = vec3( 1.0, 0.0, 1.0 );

	float charShadowKeep( in vec3 P, in vec3 Ng )
	{
		const int count = int( u_camera.charShadowParams.x );
		const float radius = u_camera.charShadowParams.y;
		float keep = 1.0;

		for ( int i = 0; i < count; i++ )
		{
			const vec4 light = u_camera.charShadowLight[i];
			const float NL = dot( Ng, light.xyz );
			if ( NL <= 0.0 )
				continue;
			vec4 c = u_camera.charShadowMvp[i] * vec4( P + Ng * 1.5, 1.0 );
			const vec4 rect = u_camera.charShadowRect[i];
			if ( any( lessThan( c.xy, max( rect.xy, vec2( -1.0 ) ) ) ) || any( greaterThan( c.xy, min( rect.zw, vec2( 1.0 ) ) ) ) || c.z <= 0.0 || c.z >= 1.0 )
				continue;
			const vec4 tile = u_camera.charShadowTile[i];
			const vec4 scale = u_camera.charShadowScale[i];
			// taps stay inside the tile (casters never reach its edge)
			const vec2 tileMin = tile.xy + vec2( radius ), tileMax = tile.xy + vec2( tile.z - radius );
			const vec2 st = clamp( tile.xy + ( c.xy * 0.5 + 0.5 ) * tile.z, tileMin, tileMax );
			const float dref = c.z - scale.z;	// 2 u of this caster's depth range
			if ( DebugCharShadow() > 2.5 ) {
				const vec2 st0 = tile.xy + ( c.xy * 0.5 + 0.5 ) * tile.z;
				if ( charDbgCover < 0.5 )
					charDbgStored = vec3( texture( sun_shadow_texture, vec4( st0, 3.0, 0.1 ) ),
						texture( sun_shadow_texture, vec4( st0, 3.0, 0.4 ) ), texture( sun_shadow_texture, vec4( st0, 3.0, 0.7 ) ) );
				charDbgCover += 1.0;
				charDbgOcclusion = max( charDbgOcclusion, 1.0 - texture( sun_shadow_texture, vec4( st0, 3.0, dref ) ) );
			}
			const float r = sunRandom( gl_FragCoord.xy ) * 6.2831853;
			const mat2 rot = mat2( cos( r ), sin( r ), -sin( r ), cos( r ) );
			const float tanHalf = u_camera.charShadowInfo.y;
			float filterRadius = radius;
			bool umbra = false;
			if ( tanHalf > 0.0 ) {
				const float search = max( dref * scale.y * tanHalf * scale.x, radius );
				// most receivers in the box are lit: four taps on the search ring first
				float ring = 0.0;
				for ( int k = 0; k < 4; k++ )
					ring += texture( sun_shadow_texture, vec4( clamp( st + rot * charDisk8[k + 4] * search, tileMin, tileMax ), 3.0, dref ) );
				if ( ring > 3.99 && texture( sun_shadow_texture, vec4( st, 3.0, dref ) ) > 0.99 )
					continue;
				float blockerSum = 0.0, blockers = 0.0;
				for ( int k = 0; k < 8; k++ ) {
					const vec2 s = clamp( st + rot * charDisk8[k] * search, tileMin, tileMax );
					if ( texture( sun_shadow_texture, vec4( s, 3.0, dref ) ) < 0.5 ) {
						float lo = 0.0, hi = dref;
						for ( int b = 0; b < 3; b++ ) {
							const float mid = 0.5 * ( lo + hi );
							if ( texture( sun_shadow_texture, vec4( s, 3.0, mid ) ) < 0.5 )
								hi = mid;
							else
								lo = mid;
						}
						blockerSum += 0.5 * ( lo + hi );
						blockers += 1.0;
					}
				}
				if ( blockers < 0.5 )
					continue;	// nothing blocks this receiver's light within its widest penumbra
				// receiver to the mean blocker, along the light, in world units
				const float distance = ( dref - blockerSum / blockers ) * scale.y;
				filterRadius = max( distance * tanHalf * scale.x, radius );
				// every search tap blocked over a disc at least as wide as the filter's: inside the umbra
				umbra = blockers > 7.5;
				if ( charDbgDistance < 0.0 )
					charDbgDistance = distance;
			}
			// taps by the filter's size in texels: the comparison sampler's bilinear 2x2 smooths small radii already
			float occlusion = 1.0;
			if ( !umbra ) {
				const float texels = filterRadius / u_camera.charShadowInfo.z;
				const int taps = texels < 3.0 ? 4 : texels < 8.0 ? 8 : 16;
				float lit = 0.0;
				for ( int k = 0; k < taps; k++ )
					lit += texture( sun_shadow_texture, vec4( clamp( st + rot * ( taps == 16 ? charDisk16[k] : charDisk8[k * 8 / taps + ( taps == 4 ? 1 : 0 )] ) * filterRadius, tileMin, tileMax ), 3.0, dref ) );
				occlusion = 1.0 - lit / float( taps );
			}
			const float fade = 1.0 - smoothstep( 0.6, 1.0, c.z );
			keep *= 1.0 - occlusion * fade * tile.w * NL / ( light.w + NL );
		}
		return keep;
	}

	// r_charSelfShadow (tr_charshadow.cpp R_SetupCharSelfShadows): a character's shadow on itself from its own grid light L.
	// Its tile in layer 3 holds the depth of the character alone along L (alpha-tested hair included, hashed). The light
	// is a disc tan( size / 2 ) wide: rays toward points spread over it march through the tile at geometric distances
	// (0.06 u to about 15 u), each blocked where the stored depth lies in front of the ray, so a nose a few units away
	// casts a sharp shadow and hair further off a soft one (a single filter radius from the mean blocker blurred both).
	// 1 = lit.
	vec3 selfDbgColor = vec3( -1.0 );
	float charSelfShadow( in vec3 P, in vec3 Ng, in vec3 L, in int slot, in bool strand )
	{
		const vec4 tile = u_camera.selfShadowTile[slot];
		const vec4 scale = u_camera.selfShadowScale[slot];
		const float edge = u_camera.selfShadowParams.y;
		const float tanHalf = u_camera.selfShadowParams.z;
		// the receiver moved off its surface along the normal, more as the light grazes it
		const float NL = clamp( dot( Ng, L ), 0.0, 1.0 );
		// r_charSelfShadowSlopeBias (selfShadowSlopeBias, layer uv): texels in world units, then a normal offset growing as the
		// light grazes and a depth bias by the receiver's slope in the tile (tan of light to normal, at most 4)
		const float slopeTexel = u_camera.selfShadowSlopeBias / scale.x;
		const float slopeTan = min( sqrt( max( 1.0 - NL * NL, 0.0 ) ) / max( NL, 0.05 ), 4.0 );
		const vec4 c = u_camera.selfShadowMvp[slot] * vec4( P + Ng * ( scale.w * ( 3.0 - 2.0 * NL ) + slopeTexel * ( 1.0 - NL ) ), 1.0 );
		if ( any( greaterThan( abs( c.xy ), vec2( 1.0 ) ) ) || c.z <= 0.0 || c.z >= 1.0 )
			return 1.0;
		const vec2 tileMin = tile.xy + vec2( edge ), tileMax = tile.xy + vec2( tile.z - edge );
		const vec2 st = tile.xy + ( c.xy * 0.5 + 0.5 ) * tile.z;
		const float dref = c.z - scale.z - slopeTexel * slopeTan / scale.y;
		// r_charSelfShadowDebug 4: the centre tap alone; 5: r = the receiver's depth, g = the stored depth found by bisection
		if ( DebugSelfShadow() > 3.5 && DebugSelfShadow() < 4.5 )
			return texture( sun_shadow_texture, vec4( clamp( st, tileMin, tileMax ), 3.0, dref ) );
		if ( DebugSelfShadow() > 4.5 ) {
			float lo = 0.0, hi = 1.0;
			for ( int b = 0; b < 12; b++ ) { const float mid = 0.5 * ( lo + hi ); if ( texture( sun_shadow_texture, vec4( st, 3.0, mid ) ) < 0.5 ) hi = mid; else lo = mid; }
			selfDbgColor = vec3( c.z, 0.5 * ( lo + hi ), 0.0 );
		}
		const float r = sunRandom( gl_FragCoord.xy ) * 6.2831853;
		const mat2 rot = mat2( cos( r ), sin( r ), -sin( r ), cos( r ) );
		const float jitter = sunRandom( gl_FragCoord.yx + 17.0 );
		// r_charSelfShadowRays (selfShadowParams.x) rays over the light, half on alpha-tested stages (stacked hair layers
		// each pay for their own); r_charSelfShadowSteps distances each, 0.06 u growing to about 12 u
		const int rays = SelfShadowRays( strand );
		const int steps = SelfShadowSteps();
		const float grow = pow( 200.0, 1.0 / float( steps - 1 ) );
		float occluded = 0.0;
		for ( int d = 0; d < 16; d++ ) {
			if ( d >= rays )
				break;
			const vec2 lean = rot * charDisk16[d * 16 / rays] * tanHalf;	// lateral uv per unit of distance toward the light, / scale.x
			float blocked = 0.0;
			for ( int k = 0; k < 12; k++ ) {
				if ( k >= steps )
					break;
				const float t = 0.06 * pow( grow, float( k ) + jitter );	// world units toward the light
				const vec2 s = clamp( st + lean * ( t * scale.x ), tileMin, tileMax );
				blocked = max( blocked, 1.0 - texture( sun_shadow_texture, vec4( s, 3.0, dref - t / scale.y ) ) );
				if ( blocked > 0.99 )
					break;
			}
			occluded += blocked;
		}
		return 1.0 - ( occluded / float( rays ) ) * tile.w;
	}

	// r_charSelfShadowHairMap (hairMapTexel = 1 / map size): the share of the first tile's grid light its hair lets
	// through to P: the share of the column's optical depth nearer the light than P, from the depth moments (the
	// column's hair spread normally, at least 0.25 u, none nearer than its nearest strand; a strand does not shadow
	// itself within 0.25 u, skin takes strands resting on it).
	// Eight taps over the light's disc widen with the receiver's distance below the hair (the penumbra).
	float hairDbg = -1.0;	// r_charSelfShadowDebug 7
	float charHairTransmittance( in vec3 P, in bool strand )
	{
		const vec4 c = u_camera.selfShadowMvp[0] * vec4( P, 1.0 );
		if ( any( greaterThan( abs( c.xy ), vec2( 1.0 ) ) ) || c.z <= 0.0 || c.z >= 1.0 )
			return 1.0;
		const float range = u_camera.selfShadowScale[0].y;	// world units across the tile's depth (and its width)
		const vec2 uv = c.xy * 0.5 + 0.5;
		const float d = ( c.z - 0.5 ) * range;
		vec4 m = textureLod( hair_map_texture, uv, 0.0 );
		float nearest = m.a;
		// the RGBA16F map holds depth as -1..1 of the range (back to world units here)
		const float du = ReviewFix( 64u ) ? 0.5 * range : 1.0;
		const float below = m.r > 1e-4 ? max( d - du * m.g / m.r, 0.0 ) : 0.0;
		const float radius = max( below * u_camera.selfShadowParams.z / range, 0.75 * u_camera.hairMapTexel );
		const float a = sunRandom( gl_FragCoord.xy ) * 6.2831853;
		const mat2 rot = mat2( cos( a ), sin( a ), -sin( a ), cos( a ) );
		for ( int k = 0; k < 8; k++ ) {
			const vec4 t = textureLod( hair_map_texture, uv + rot * charDisk8[k] * radius, 0.0 );
			m.rgb += t.rgb;
			nearest = min( nearest, t.a );
		}
		m.rgb /= 9.0;
		m.g *= du;
		m.b *= du * du;
		nearest *= du;
		const float R = m.r * u_camera.hairMapDensity;
		if ( R < 1e-4 )
			return 1.0;
		// only the hair nearer the light than P, skin included: the depth tile the strands were cut against
		// holds the body's far side (shadow views flip culling, r_charShadowCull 0), so lengths lying on her back passed
		// as "in front" and, counted whole, streaked her chest and stomach. Skin keeps strands up to 0.25 u behind it
		// (hair resting on it); a strand drops those within 0.25 u of itself (r_charSelfShadowHairStrandDepth, -0.25)
		const float mu = m.g / m.r;
		const float sigma = sqrt( max( m.b / m.r - mu * mu, 0.0625 ) );
		const float ds = d + ( strand ? u_camera.hairStrandDepth : 0.25 );
		const float share = clamp( ( ds - nearest ) / 0.5, 0.0, 1.0 ) / ( 1.0 + exp( -1.702 * ( ds - mu ) / sigma ) );
		return exp( -R * share );
	}
#endif

void main() {
	vec4 diffuse;
	float attenuation;
	vec3 viewDir, lightColor, ambientColor;
	vec3 L, N, E;

#if defined(PER_PIXEL_LIGHTING)
	var_Normal = var_NormalIn;
	if ( two_sided != 0 && gl_FrontFacing == ( two_sided == 2 ) ) {
		var_Normal.xyz = -var_Normal.xyz;
		g_backFace = true;
	}
#endif

	vec2 texCoord0 = frag_tex_coord0;
#if defined(PER_PIXEL_LIGHTING)
	// r_stylePassSimple (normalScale.z 0.25): a lightmap style pass without parallax, normal map or specular
	const bool simpleStylePass = u_global.normalScale.z > 0.125 && u_global.normalScale.z < 0.5;
	vec2 parallaxOffset = vec2( 0.0 );
	if ( normal_texture_set > 0 && !simpleStylePass ) {
		parallaxOffset = GetParallaxOffset( texCoord0 );
		texCoord0 += parallaxOffset;
	}
	// eye: the iris seen through the cornea (every map of the stage follows the refracted coordinates)
	if ( ( material_mode & 8 ) != 0 )
		texCoord0 += EyeIrisOffset( texCoord0 );
#endif

	vec4 tex0 = texture(texture0, texCoord0);
#if defined(PER_PIXEL_LIGHTING)
	// r_charSkinSoftAlbedo (test, camera skinSoftAlbedo): skin albedo read from blurrier mips per channel, red by the
	// value, green by half, so pores and freckles soften the way light scattering under the skin blurs them
	if ( ( material_mode & 1 ) != 0 && u_camera.skinSoftAlbedo > 0.0 )
		tex0.rg = vec2( texture( texture0, texCoord0, u_camera.skinSoftAlbedo ).r, texture( texture0, texCoord0, 0.5 * u_camera.skinSoftAlbedo ).g );
#endif
#ifdef USE_CL0_IDENT
	vec4 color0 = tex0 * vec4( identity_color );
#else
	vec4 color0 = tex0 * frag_color0;
#endif

	vec4 base;

#if defined (USE_TX2)
#ifdef USE_CL2
	// soecial blend modes for non-identity colors
	if ( tex_mode == 1 || tex_mode == 2 )
	{
		// add
		vec4 color1 = texture(texture1, frag_tex_coord1) * frag_color1;
		vec4 color2 = texture(texture2, frag_tex_coord2) * frag_color2;

		base = vec4( color0.rgb + color1.rgb + color2.rgb, color0.a * color1.a * color2.a );
	}
	else if ( tex_mode == 3 )
	{
		// modulate by alpha
		vec4 color1 = texture(texture1, frag_tex_coord1) * frag_color1;
		vec4 color2 = texture(texture2, frag_tex_coord2) * frag_color2;

		color0 *= color0.a;
		color1 *= color1.a;
		color2 *= color2.a;
		base = vec4( color0.rgb + color1.rgb + color2.rgb, color0.a * color1.a * color2.a );
	}
	else if ( tex_mode == 4 )
	{
		// modulate by 1.0-alpha
		vec4 color1 = texture(texture1, frag_tex_coord1) * frag_color1;
		vec4 color2 = texture(texture2, frag_tex_coord2) * frag_color2;

		color0 *= 1.0-color0.a;
		color1 *= 1.0-color1.a;
		color2 *= 1.0-color2.a;
		base = vec4( color0.rgb + color1.rgb + color2.rgb, color0.a * color1.a * color2.a );
	}
	else if ( tex_mode == 5 )
	{
		// mix by src alpha
		vec4 color1 = texture(texture1, frag_tex_coord1) * frag_color1;
		vec4 color2 = texture(texture2, frag_tex_coord2) * frag_color2;

		//base = mix( color0, color1, color1.a );
		//base = mix( base, color2, color2.a );
		base = mix( mix( color0, color1, color1.a ), color2, color2.a );
	}
	else if ( tex_mode == 6 )
	{
		// mix by 1-src alpha
		vec4 color1 = texture(texture1, frag_tex_coord1) * frag_color1;
		vec4 color2 = texture(texture2, frag_tex_coord2) * frag_color2;

		//base = mix( color1, color0, color1.a );
		//base = mix( color2, base, color2.a );
		base = mix( color2, mix( color1, color0, color1.a ), color2.a );
	}
	else if ( tex_mode == 7 ) // 0 + 2x GLS_DSTBLEND_SRC_ALPHA | GLS_SRCBLEND_DST_COLOR
	{
		vec4 color1 = texture(texture1, frag_tex_coord1) * frag_color1;
		vec4 color2 = texture(texture2, frag_tex_coord2) * frag_color2;

		base = (color2 + color2.a) * (color1 + color1.a) * color0;
	}
	else
	{
		vec4 color1 = texture(texture1, frag_tex_coord1) * frag_color1;
		vec4 color2 = texture(texture2, frag_tex_coord2) * frag_color2;
		base = color0 * color1 * color2;
	}
#else
	// triple-texture blending
	if ( tex_mode == 1 )
	{
		// add (identity)
		vec4 color1 = texture(texture1, frag_tex_coord1);
		vec4 color2 = texture(texture2, frag_tex_coord2);
		base = vec4(color0.rgb + color1.rgb + color2.rgb, color0.a * color1.a * color2.a);
	}
	else if ( tex_mode == 2 )
	{
		// add
		vec4 color1 = texture(texture1, frag_tex_coord1) * frag_color0;
		vec4 color2 = texture(texture2, frag_tex_coord2) * frag_color0;
		base = vec4(color0.rgb + color1.rgb + color2.rgb, color0.a * color1.a * color2.a);
	}
	else 
	{
		// default case, modulate
		vec4 color1 = texture(texture1, frag_tex_coord1);
		vec4 color2 = texture(texture2, frag_tex_coord2);
		base = color0 * color1 * color2;
	}
#endif // !USE_TX2
#elif defined(USE_TX1)
#ifdef USE_CL1
	// soecial blend modes for non-identity colors
	if ( tex_mode == 1 || tex_mode == 2 )
	{
		// add
		vec4 color1 = texture(texture1, frag_tex_coord1) * frag_color1;
		base = vec4( color0.rgb + color1.rgb, color0.a * color1.a );
	}
	else if ( tex_mode == 3 ) // 2x GLS_DSTBLEND_ONE | GLS_SRCBLEND_SRC_ALPHA
	{
		// modulate by alpha
		vec4 color1 = texture(texture1, frag_tex_coord1) * frag_color1;
		color0 *= color0.a;
		color1 *= color1.a;
		base = vec4( color0.rgb + color1.rgb, color0.a * color1.a );
	}
	else if ( tex_mode == 4 ) // 2x GLS_DSTBLEND_ONE | GLS_SRCBLEND_ONE_MINUS_SRC_ALPHA
	{
		// modulate by 1.0-alpha
		vec4 color1 = texture(texture1, frag_tex_coord1) * frag_color1;
		color0 *= 1.0-color0.a;
		color1 *= 1.0-color1.a;
		base = vec4( color0.rgb + color1.rgb, color0.a * color1.a );
	}
	else if ( tex_mode == 5 ) // 0 + GLS_DSTBLEND_ONE_MINUS_SRC_ALPHA | GLS_SRCBLEND_SRC_ALPHA
	{
		// mix by src alpha
		vec4 color1 = texture(texture1, frag_tex_coord1) * frag_color1;
		base = mix( color0, color1, color1.a );
	}
	else if ( tex_mode == 6 ) // 0 + GLS_DSTBLEND_SRC_ALPHA | GLS_SRCBLEND_ONE_MINUS_SRC_ALPHA
	{
		// mix by 1-src alpha
		vec4 color1 = texture(texture1, frag_tex_coord1) * frag_color1;
		base = mix( color1, color0, color1.a );
	}
	else if ( tex_mode == 7 ) // 0 + GLS_DSTBLEND_SRC_ALPHA | GLS_SRCBLEND_DST_COLOR
	{
		// modulate color1 by color0
		// moduleta color0 by color1.alpha
		vec4 color1 = texture(texture1, frag_tex_coord1) * frag_color1;
		base = (color1 + color1.a) * color0;
	}
	else
	{
		// default case, modulate
		vec4 color1 = texture(texture1, frag_tex_coord1) * frag_color1;
		base = color0 * color1;
	}
#else
	// double-texture blending
	if ( tex_mode == 1 )
	{
		// add (identity)
		vec4 color1 = texture(texture1, frag_tex_coord1);
		base = vec4(color0.rgb + color1.rgb, color0.a * color1.a);
	}
	else if ( tex_mode == 2 )
	{
		// add
		vec4 color1 = texture(texture1, frag_tex_coord1) * frag_color0;
		base = vec4(color0.rgb + color1.rgb, color0.a * color1.a);
	}
