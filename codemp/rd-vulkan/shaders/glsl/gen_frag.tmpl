				if ( fmaSlot >= 0 && fmaSlot < 5 && !fmaInMask && !SimCloth() )
					fmaShadow = min( fmaShadow, charSelfShadow( P, normalize( var_Normal.xyz ), L, fmaSlot, fmaStrand ) );
				if ( fmaSlot == 0 && u_camera.hairMapTexel > 0.0 && !SimCloth() )
					fmaShadow *= 1.0 - ( 1.0 - charHairTransmittance( P, fmaStrand ) ) * u_camera.selfShadowTile[0].w;
