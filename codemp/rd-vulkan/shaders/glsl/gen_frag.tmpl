		// fragment writes neither colour nor depth; stop it here instead of lighting it (hair cards: most of a card is
		// transparent). Only where the output alpha is this base.a: not the lightmap path's color0.a, not after a fog mix
		if ( base.a <= 0.0 && u_camera.a2cDiscard > 0.5 )
			discard;
	#endif
#endif // USE_SAMPLE_MASK
	} else
	// specialization: alpha-test function
	if (alpha_test_func == 1) {
		if (color0.a == alpha_test_value) discard;
	} else if (alpha_test_func == 2) {
		if (color0.a >= alpha_test_value) discard;
	} else if (alpha_test_func == 3) {
		if (color0.a < alpha_test_value) discard;
	}
#endif

	if ( discard_mode == 1 ) {
		if ( base.a == 0.0 ) {
			discard;
		}
	} else if ( discard_mode == 2 ) {
		if ( dot( base.rgb, base.rgb ) == 0.0 ) {
			discard;
		}
	}

#ifdef USE_DF
	if ( base.a < depth_fragment )
		discard;

	gl_FragDepth = gl_FragCoord.z;
#else

