		vec4 detailMap = vec4( 0.5 );
		float detailMapWeight = 0.0;
		if ( detail_map_set > -1 ) {
			detailMap = texture( detail_map_texture, texCoord0 * u_global.detailMapParams.x );
			detailMapWeight = u_global.detailMapParams.y * matMask.a;
			diffuse.rgb *= mix( vec3( 1.0 ), 2.0 * detailMap.rgb, detailMapWeight );
		}

		// toonShadeMap: the shade side's albedo per texel (sRGB like the albedo)
		if ( ( material_mode & 16 ) != 0 && u_global.toonLight.w > 0.5 && detail_map_set < 0 ) {
			toonShadeTex = texture( detail_map_texture, texCoord0 ).rgb;
			if ( linearLight )
				toonShadeTex = SRGBToLinear( toonShadeTex );
		}

		// rend2's colorScale (mapLightScale) scales the stage colours that carry this light
		lightColor *= u_camera.sunAmbCol.w;
		ambientColor *= u_camera.sunAmbCol.w;

		// r_charFill / r_charRim / r_charAmbientFloor (Ghoul2 models lit by the light grid: u_entity.charFill.w = 1 + fill
		// level, 0 elsewhere): the grid's whole light here, before any shadow takes from it
		vec3 gridTotal = vec3( 0.0 );
		#if defined(USE_LIGHT_VECTOR)
			gridTotal = lightColor + ambientColor;
			// r_charAmbientFloor (camera charAmbientFloor): the ambient is at least this share of the grid's whole light, in its
			// colour, so a character's shade side (and what its own hat or hair shadows) keeps some light
			if ( u_entity.charFill.w > 0.5 && u_camera.charAmbientFloor > 0.0 ) {
				const vec3 lumW = vec3( 0.2126, 0.7152, 0.0722 );
				const float total = dot( gridTotal, lumW );
				const float lift = max( u_camera.charAmbientFloor * total - dot( ambientColor, lumW ), 0.0 );
				ambientColor += gridTotal * ( lift / max( total, 1e-4 ) );
			}
		#endif

		// character shadows remove the share of the baked light a caster blocks (lightmap and vertex light only)
		float charKeep = 1.0;
		#if defined(USE_LIGHTMAP) || defined(USE_LIGHT_VERTEX)
			if ( u_camera.charShadowParams.x > 0.0 ) {
				charKeep = charShadowKeep( u_camera.viewOrigin.xyz - var_ViewDir.xyz, normalize( var_Normal.xyz ) );
				lightColor *= charKeep;
			}
		#endif

		N = simpleStylePass ? normalize( var_Normal.xyz ) : CalcNormal( var_Normal.xyz, var_Tangent, texCoord0, normalTexel, layerMask, matMask.a );

		// rend2's sun (lightall.glsl, r_sunlightMode). No shadow maps yet: sunShadow() is 1, so the shadow value
		// is the normal's facing to the sun. Mode 1 modulates the light by the shadow scale away from the sun,
		// mode 2 adds the sun as a primary light below.
		// a lightmap style pass (normalScale.z < 0.5, LitLightmapStyles) adds only its style's light: the base pass
		// already added the sun, cubemap reflections and dynamic lights; -1 adds the sun again (rend2, r_sunStylePasses 1)
		const bool stylePass = u_global.normalScale.z < 0.5;
		const int sunMode = ( !stylePass || u_global.normalScale.z < -0.5 ) ? int( u_camera.sunDir.w ) : 0;
		vec3 sunL = vec3( 0.0 );
		float sunShadowValue = 0.0;
		if ( sunMode != 0 ) {
			sunL = normalize( u_camera.sunDir.xyz );
			const float NPL = clamp( dot( N, sunL ), 0.0, 1.0 );
			sunShadowValue = NPL;
			// cascades rendered for this scene: rend2's lookup with the normal bias vertexNormal * (1 - NPL)
			if ( u_camera.sunShadowParams.x > 0.0 && NPL > 0.0 )
				sunShadowValue = sunShadow( u_camera.viewOrigin.xyz, var_ViewDir.xyz, var_Normal.xyz * ( 1.0 - NPL ) ) * NPL;
			if ( sunMode == 1 )
				lightColor = mix( u_camera.sunAmbCol.rgb * lightColor, lightColor, sunShadowValue );
		}
	

		#if defined(USE_LIGHTMAP) || defined(USE_LIGHT_VERTEX)
			ambientColor = lightColor;
			float surfNL = clamp(dot(var_Normal.xyz, L), 0.0, 1.0);
			lightColor /= max( surfNL, 0.25 );
			ambientColor = max( ambientColor - lightColor * surfNL, 0.0 );
		#endif

		#if defined(USE_LIGHTMAP) && defined(USE_TX1)
		const vec3 dbgLightmap = texture( texture1, frag_tex_coord1 ).rgb;
		#else
		const vec3 dbgLightmap = vec3( 0.0 );
		#endif
		// r_sunShadowDebug 5..9 (probes): the light before the PI scale, its N.L, L, the diffuse, the pre-PI ambient
		const vec3 dbgLight = lightColor;
		const vec3 dbgAmbient = ambientColor;
		lightColor *= M_PI;

		// r_charContactShadows: the light grid's directed light on models, blocked by the opaque depth prepass
		float contactGrid = 1.0;
		float selfShadowValue = -1.0;	// r_charSelfShadowDebug 1: the self-shadow's lit share (-1: none here)
		#if defined(USE_LIGHT_VECTOR)
			// r_charFast 2: the grid light does not reach the surface; its shadows need no lookup (the contact ray's quad
			// mean needs the whole quad facing away)
			const bool gridAway = ( CharFast() & 2 ) != 0 && CharLightAway( N, L );
			bool gridContact = u_camera.charOccParams.y > 0.0 && !stylePass && max( lightColor.r, max( lightColor.g, lightColor.b ) ) > 0.0;
			if ( gridContact && ( CharFast() & 2 ) != 0 )
				gridContact = QuadMean( gridAway ? 0.0 : 1.0 ) > 0.0;
			if ( gridContact ) {
				contactGrid = ContactShadow( u_camera.viewOrigin.xyz - var_ViewDir.xyz, L, GridContactChannel(), 0.0 );
				// r_charContactGridShare: the grid's directed light is a fit of light from many directions; a blocker
				// takes only its directed share (directed / (directed + ambient))
				if ( u_camera.charOccGridShare > 0.0 ) {
					const float d = dot( lightColor, vec3( 0.2126, 0.7152, 0.0722 ) ) / M_PI;	// lightColor carries PI here
					const float a = dot( ambientColor, vec3( 0.2126, 0.7152, 0.0722 ) );
					contactGrid = 1.0 - ( 1.0 - contactGrid ) * mix( 1.0, d / max( d + a, 1e-4 ), u_camera.charOccGridShare );
				}
			}
			// r_charSelfShadow: the character's own shadow from this light; the contact shadow adds what the map's
			// texels miss (lids, lashes), the darker of the two counts
			const int selfSlot = SelfShadowSlot();
			#ifdef USE_ATEST
				const bool selfStrand = alpha_test_func != 0;
			#else
				const bool selfStrand = false;
			#endif
			// r_charSelfShadowScreen (selfShadowInMask): the first tile's opaque stages have it in the grid light's mask already
			const bool selfInMask = u_camera.selfShadowInMask > 0.5 && selfSlot == 0 && !selfStrand && GridContactChannel() > 0;
			if ( selfSlot >= 0 && selfSlot < 5 && !selfInMask && !stylePass && !gridAway && !SimCloth() && max( lightColor.r, max( lightColor.g, lightColor.b ) ) > 0.0 ) {
				selfShadowValue = charSelfShadow( u_camera.viewOrigin.xyz - var_ViewDir.xyz, normalize( var_Normal.xyz ), L, selfSlot, selfStrand );
				contactGrid = min( contactGrid, selfShadowValue );
			}
			// r_charSelfShadowHairMap: the first tile's hair, through its map (its depth tile holds the opaque body only)
			if ( selfSlot == 0 && u_camera.hairMapTexel > 0.0 && !stylePass && !gridAway && !SimCloth() && max( lightColor.r, max( lightColor.g, lightColor.b ) ) > 0.0 ) {
				hairDbg = charHairTransmittance( u_camera.viewOrigin.xyz - var_ViewDir.xyz, selfStrand );
				contactGrid *= 1.0 - ( 1.0 - hairDbg ) * u_camera.selfShadowTile[0].w;
			}
			// toon: the shadow moves its step instead (the shaded side keeps the light: the shade colour in it)
			if ( ( material_mode & 16 ) != 0 )
				toonShadow = contactGrid;
			else
				lightColor *= contactGrid;
		#endif

		vec4 specular = vec4( 1.0 );
		float roughness = 0.99;	// perceptual from the decode below on (common/pbr.glsl's convention)
		float metal = 0.0;		// metalness (metal-roughness maps), for roughnessEncoding metalpow
		float AO = 1.0;

		// metallic roughness workflow
		if ( physical_texture_set < 0 )
		{
			vec4 ORMS = texture( physical_texture, texCoord0 );
			ORMS.xyzw *= u_global.specularScale.zwxy;
			if ( layer_count > 0 )
				ORMS.yz = ORMS.yz * layerKeep + layerRM;
			specular.rgb = mix( vec3( 0.08 ) * ORMS.w, diffuse.rgb, ORMS.z );
			diffuse.rgb *= vec3( 1.0 - ORMS.z );

			roughness = mix( 0.01, 1.0, ORMS.y );
			metal = ORMS.z;
			AO = min( ORMS.x, AO );
		}

		// specular gloss workflow: gloss = 1 - perceptual roughness (glTF KHR_materials_pbrSpecularGlossiness,
		// Substance, Marmoset). rend2 drew it as 1 - GGX alpha in direct light (and perceptual in reflections), so
		// rend2 / Q3 spec-gloss maps keep their reflections and get tighter, brighter highlights; roughnessEncoding
		// alpha on the stage restores rend2's highlights
		else
		{
			specular = texture( physical_texture, texCoord0 );
			specular.rgb *= u_global.specularScale.xyz;
			roughness = mix( 1.0, 0.01, specular.a * ( 1.0 - u_global.specularScale.w ) );
			// layers: their roughness over the stage's (metalness has no place in spec-gloss)
			if ( layer_count > 0 )
				roughness = roughness * layerKeep + 0.01 * ( 1.0 - layerKeep ) + 0.99 * layerRM.x;
		}

		if ( detail_map_set > -1 )
			roughness = clamp( roughness * mix( 1.0, 2.0 * detailMap.a, detailMapWeight ), 0.01, 1.0 );

		// roughnessEncoding: the stored value (maps, layers and detail, in the stage's own encoding) to perceptual
		if ( roughness_encoding == 1 )
			roughness = sqrt( roughness );
		else if ( roughness_encoding == 2 )
			roughness = pow( roughness, 1.0 / ( 2.0 - clamp( metal, 0.0, 1.0 ) ) );

		// r_specularAA: geometric specular anti-aliasing (Tokuyoshi & Kaplanyan 2019). Where the shading normal turns
		// across a pixel, a sharp highlight would alias; widen GGX alpha by the normal's screen-space variance
		// (sigma^2 0.25, clamp 0.18): alpha'^2 = alpha^2 + kernel, then back to perceptual roughness (alpha = r^2).
		if ( u_global.lightParams.z > 0.5 ) {
			const vec3 dNdx = dFdx( N ), dNdy = dFdy( N );
			const float kernel = min( 0.5 * ( dot( dNdx, dNdx ) + dot( dNdy, dNdy ) ), 0.18 );
			const float a = roughness * roughness;
			roughness = sqrt( sqrt( clamp( a * a + kernel, 0.0, 1.0 ) ) );
		}


		// subsurface fills the occluded cavities back in
		if ( ( material_mode & 1 ) != 0 )
			AO = mix( AO, 1.0, 0.5 * clamp( u_global.subsurfaceParams.w * matMask.r, 0.0, 1.0 ) );

		// r_charAO: the prepass's ambient occlusion on models' ambient and reflections (not their direct light);
		// alpha-tested stages (hair) are not in the prepass, so they take none (single-texture variants all carry
		// USE_ATEST; the test itself is the alpha_test_func constant)
		float screenAO = 1.0;
		#if defined(USE_LIGHT_VECTOR)
		#ifdef USE_ATEST
			const bool alphaTested = alpha_test_func != 0;
		#else
			const bool alphaTested = false;
		#endif
			if ( u_camera.charOccParams.x > 0.0 && !alphaTested ) {
				screenAO = mix( 1.0, ScreenAO(), u_camera.charOccParams.x );
				AO *= screenAO;
			}
		#endif

		// r_cubeMapDiffuse (models lit by the light grid): the grid gives one flat ambient colour. The probes' irradiance
		// toward N against its mean with the opposite side (the average over both hemispheres) shapes it: brighter
		// toward bright surroundings, darker toward dark floors, tinted by nearby colours, at the grid's brightness.
		#if defined(USE_LIGHT_VECTOR)
			if ( env_texture_set > -1 && !stylePass && u_global.lightParams.x > 0.0 && u_global.cubeProbes[0].w > 0.0 ) {
				const vec3 P = u_camera.viewOrigin.xyz - var_ViewDir.xyz;
				const vec3 front = SampleIrradiance( P, N ), back = SampleIrradiance( P, -N );
				const vec3 sum = front + back;
				const vec3 shape = vec3( greaterThan( sum, vec3( 1e-4 ) ) ) * ( 2.0 * front / max( sum, vec3( 1e-4 ) ) - 1.0 ) + 1.0;
				// toon: mostly flat (a third of the shaping keeps bright and dark surroundings readable)
				ambientColor *= mix( vec3( 1.0 ), shape, u_global.lightParams.x * ( ( material_mode & 16 ) != 0 ? 0.33 : 1.0 ) );
			}
		#endif

		ambientColor *= AO;

		vec3  H  = normalize( L + E );
		float NE = abs( dot( N, E ) ) + 1e-5;
		float NL = clamp( dot( N, L ), 0.0, 1.0 );
		float LH = clamp( dot( L, H ), 0.0, 1.0 );

		vec3  Fd = CalcDiffuse( diffuse.rgb, NE, NL, LH, roughness );
		vec3  Fs = vec3( 0.0 );

		#if defined(USE_LIGHT_VECTOR)
			float NH = clamp( dot( N, H ), 0.0, 1.0 );
			float VH = clamp( dot( E, H ), 0.0, 1.0 );
			Fs = CalcSpecular( specular.rgb, NH, NL, NE, LH, VH, roughness );
		#endif

		// ~sunny
		// allow specular highlights even with r_deluxeMapping 0.
		// lightgrid approximation is sufficient for specular highlights.
#if 1
		// deluxe_specular_scale will be 1.0 when r_deluxeMapping = 0
		// and match r_deuxeSpecular value when r_deluxeMapping = 1
		#if defined(USE_LIGHTMAP) || defined(USE_LIGHT_VERTEX)
			if ( deluxe_specular_scale != 0.0 && !simpleStylePass )
			{
				float NH = clamp( dot( N, H ), 0.0, 1.0 );
				float VH = clamp( dot( E, H ), 0.0, 1.0 );
				Fs = CalcSpecular( specular.rgb, NH, NL, NE, LH, VH, roughness ) * deluxe_specular_scale;
			}
		#endif
#else
		// rend2 behavior: skip specular when r_deluxeMapping = 0 on lightmapped surfaces
		#if ( defined(USE_LIGHTMAP) || defined(USE_LIGHT_VERTEX) )
			if ( deluxe_specular_scale != 0.0 
			#if defined(USE_LIGHTMAP)
				&& deluxe_mapping > -1
			#endif
				){
					float NH = clamp(dot(N, H), 0.0, 1.0);
					float VH = clamp(dot(E, H), 0.0, 1.0);
					Fs = CalcSpecular( specular.rgb, NH, NL, NE, LH, VH, roughness) * deluxe_specular_scale;
				}
		#endif
#endif

		if ( material_mode != 0 ) {
			if ( ( material_mode & 16 ) != 0 ) {
				// toon: the grid's directed and ambient light as one light through the step, so the shade colour alone
				// sets the contrast (a lit point is as bright as the plain path's at N.L 1), at toonLight.x of its colour
				// (the rest its brightness in grey); the stage's whole light is compressed at the end (ToonExposure)
				const vec3 gridLight = ToonLightColor( lightColor * ( 1.0 / M_PI ) + ambientColor );
				toonMain = true;
				out_color.rgb = gridLight * M_PI * MaterialLight( N, L, E, NE, Fd, Fs, diffuse.rgb, specular.rgb, matMask ) * attenuation;
				toonMain = false;
				// rim: past 1 - N.V = 1 - width (toonSkinShade.w soft), the albedo x rim colour in that light
				if ( u_global.toonRim.w > 0.0 ) {
					const float edge = 1.0 - u_global.toonRim.w;
					const float rim = smoothstep( edge - u_global.toonSkinShade.w, edge + u_global.toonSkinShade.w, 1.0 - min( NE, 1.0 ) );
					out_color.rgb += gridLight * diffuse.rgb * u_global.toonRim.rgb * rim;
				}
			} else {
				out_color.rgb  = lightColor * MaterialLight( N, L, E, NE, Fd, Fs, diffuse.rgb, specular.rgb, matMask ) * attenuation;
				out_color.rgb += ambientColor * diffuse.rgb;
			}
			toonShadow = 1.0;
			// sheen under ambient light: the lobe's grazing rim
			if ( ( material_mode & 4 ) != 0 )
				out_color.rgb += ambientColor * u_global.sheenParams.rgb * ( matMask.g * 0.5 * pow( 1.0 - min( NE, 1.0 ), 3.0 ) );
		} else {
			vec3 reflectance = Fd + ( ( CharTerms() & 1 ) != 0 ? vec3( 0.0 ) : Fs );

			out_color.rgb  = lightColor * reflectance * ( attenuation * NL );
			out_color.rgb += ambientColor * diffuse.rgb;
		}

		// r_charFill: soft light from the camera's side away from the grid light, occluded like the ambient (AO);
		// r_charRim: from behind on the grid light's side, unshadowed (it lights the silhouette). Both a share of the
		// grid's whole light, so they follow the map's brightness and colour.
		#if defined(USE_LIGHT_VECTOR)
			if ( u_entity.charFill.w > 0.5 && !stylePass ) {
				const float fillLevel = u_entity.charFill.w - 1.0;
				if ( fillLevel > 0.0 )
					out_color.rgb += ToonLightColor( gridTotal ) * ( fillLevel * M_PI * AO ) * CharGridExtra( u_entity.charFill.xyz, N, E, NE,
						diffuse.rgb, specular.rgb, roughness, matMask );
				if ( u_entity.charRim.w > 0.0 )
					out_color.rgb += ToonLightColor( gridTotal ) * ( u_entity.charRim.w * M_PI ) * CharGridExtra( u_entity.charRim.xyz, N, E, NE,
						diffuse.rgb, specular.rgb, roughness, matMask );
			}
		#endif

			
		#ifdef VK_DLIGHT_GPU
			if ( !stylePass && material_mode != 0 )
				out_color.rgb += CalcDynamicLightMaterial( roughness, N, E, u_camera.viewOrigin.xyz - viewDir, NE, diffuse.rgb, specular.rgb, matMask );
			else if ( !stylePass )
				out_color.rgb += CalcDynamicLightContribution(roughness, N, E, u_camera.viewOrigin.xyz, viewDir, NE, diffuse.rgb, specular.rgb, var_Normal.xyz);
		#endif

		// r_specularOcclusion: the material's AO occludes the whole reflection, more at grazing angles and on smooth
		// surfaces (Lagarde & de Rousiers 2014, "Moving Frostbite to PBR"; their roughness is GGX alpha, r^2). Off: AO
		// scales the reflectance at normal incidence only, as before.
		if ( env_texture_set > -1 && !stylePass && ( CharTerms() & 2 ) == 0 ) {
			if ( u_global.lightParams.y > 0.5 )
				out_color.rgb += CalcIBLContribution( roughness, N, E, NE, specular.rgb, u_camera.viewOrigin.xyz - var_ViewDir.xyz )
					* clamp( pow( NE + AO, exp2( -16.0 * RoughnessToAlpha( roughness ) - 1.0 ) ) - 1.0 + AO, 0.0, 1.0 );
			else
				out_color.rgb += CalcIBLContribution( roughness, N, E, NE, specular.rgb * AO, u_camera.viewOrigin.xyz - var_ViewDir.xyz );
			// eye: the cornea mirrors the surroundings sharply on the geometric normal
			if ( ( material_mode & 8 ) != 0 ) {
				const vec3 Ng = normalize( var_Normal.xyz );
				out_color.rgb += CalcIBLContribution( CorneaRoughness(), Ng, E, abs( dot( Ng, E ) ) + 1e-5,
					vec3( CorneaF0() ), u_camera.viewOrigin.xyz - var_ViewDir.xyz );
			}
		}

		// r_cubeMapDebug 4: the probes' irradiance toward N; 5: the ambient light after r_cubeMapDiffuse (x4)
		if ( env_texture_set > -1 && !stylePass && DebugCubeMap() > 3.5 )
			out_color.rgb = DebugCubeMap() < 4.5 ? SampleIrradiance( u_camera.viewOrigin.xyz - var_ViewDir.xyz, N ) : ambientColor * 4.0;
		else if ( env_texture_set > -1 && !stylePass && DebugCubeMap() > 0.5 )
			out_color.rgb = CalcIBLDebug( var_Normal.xyz, E, u_camera.viewOrigin.xyz - var_ViewDir.xyz );

		if ( sunMode == 2 ) {
			// rend2 quirks kept for parity: VH uses the first light's half vector, the shadow value carries a
			// second N.L, and entities get the sun on top of the light grid
			vec3  H2   = normalize( sunL + E );
			float NL2  = clamp( dot( N, sunL ), 0.0, 1.0 );
			float L2H2 = clamp( dot( sunL, H2 ), 0.0, 1.0 );
			float NH2  = clamp( dot( N, H2 ), 0.0, 1.0 );
			float VH2  = clamp( dot( E, H ), 0.0, 1.0 );
			// (r_charTerms 1 drops its specular too: the sun is the direct light of a character in a render scene)
			const vec3 sunSpec = ( CharTerms() & 1 ) != 0 ? vec3( 0.0 ) : CalcSpecular( specular.rgb, NH2, NL2, NE, L2H2, VH2, roughness );
			vec3 sunReflectance = CalcDiffuse( diffuse.rgb, NE, NL2, L2H2, roughness ) + sunSpec;
			if ( ( material_mode & 16 ) != 0 ) {
				// toon: the cascades' shadow moves the step (sunShadowValue carries N.L, divided out); the sun lights both sides
				toonShadow = NL2 > 0.0 ? clamp( sunShadowValue / NL2, 0.0, 1.0 ) : 1.0;
				out_color.rgb += ToonLightColor( u_camera.sunCol.rgb ) * MaterialLight( N, sunL, E, NE, vec3( 0.0 ), vec3( 0.0 ), diffuse.rgb, specular.rgb, matMask );
				toonShadow = 1.0;
			}
			else if ( material_mode != 0 )
				out_color.rgb += u_camera.sunCol.rgb * sunShadowValue * MaterialLight( N, sunL, E, NE, CalcDiffuse( diffuse.rgb, NE, NL2, L2H2, roughness ),
					sunSpec, diffuse.rgb, specular.rgb, matMask );
			else
			out_color.rgb += u_camera.sunCol.rgb * sunShadowValue * sunReflectance * NL2;
		}

		if ( ( material_mode & 16 ) != 0 && !stylePass )
			out_color.rgb = ToonExposure( out_color.rgb, diffuse.rgb );

		// r_charLinear: back to the sRGB-encoded target (reflections and the sun stay as they were added)
		// (3, in a render scene: its own tone curve, R_SceneCharTone)
		if ( linearLight ) {
			const float lm = mod( u_entity.ambientLight.w, 10.0 );
			out_color.rgb = lm > 2.5 && u_camera.charTone.x > 0.5 ? SceneToneDisplay( max( out_color.rgb, 0.0 ) )
				: LinearToSRGB( lm > 1.5 ? PBRNeutral( max( out_color.rgb, 0.0 ) ) : clamp( out_color.rgb, 0.0, 1.0 ) );
		}

		if ( selfDbgColor.x >= 0.0 )
			out_color.rgb = selfDbgColor;
		if ( DebugSelfShadow() > 0.5 && DebugSelfShadow() < 1.5 || DebugSelfShadow() > 3.5 && DebugSelfShadow() < 4.5 && selfShadowValue >= 0.0 )
			out_color.rgb = vec3( selfShadowValue );
		// r_charSelfShadowDebug 3: the first tile as the light sees it, tiled over the screen (r/g/b = stored depth >= 0.3/0.5/0.7)
		if ( DebugSelfShadow() > 2.5 && DebugSelfShadow() < 3.5 && u_camera.selfShadowParams.x > 0.5 ) {
			const vec4 t = u_camera.selfShadowTile[0];
			const vec2 s = t.xy + fract( gl_FragCoord.xy / 1100.0 ) * t.z;
			out_color.rgb = vec3( texture( sun_shadow_texture, vec4( s, 3.0, 0.3 ) ), texture( sun_shadow_texture, vec4( s, 3.0, 0.5 ) ), texture( sun_shadow_texture, vec4( s, 3.0, 0.7 ) ) );
		}
		// r_charSelfShadowDebug 6: the first tile's stored depth over a 1100 px square (left edge 250), the tile square
		// r_charSelfShadowDebugBox "x y size" (tile uv, centre and side); depth = r + g / 16 (1 = nothing stored)
		if ( DebugSelfShadow() > 5.5 && DebugSelfShadow() < 6.5 && u_camera.selfShadowParams.x > 0.5 ) {
			const vec4 t = u_camera.selfShadowTile[0];
			const vec2 q = ( gl_FragCoord.xy - vec2( 250.0, 0.0 ) ) / 1100.0;
			const vec2 s = t.xy + ( u_camera.selfShadowDebugBox.xy + ( q - 0.5 ) * u_camera.selfShadowDebugBox.z ) * t.z;
			float lo = 0.0, hi = 1.0;
			for ( int b = 0; b < 16; b++ ) { const float mid = 0.5 * ( lo + hi ); if ( texture( sun_shadow_texture, vec4( s, 3.0, mid ) ) < 0.5 ) hi = mid; else lo = mid; }
			const float d16 = 0.5 * ( lo + hi ) * 16.0;
			out_color.rgb = vec3( floor( d16 ) / 16.0, fract( d16 ), 0.0 );
		}
		// r_charSelfShadowDebug 7: the hair map's transmittance alone (white = no hair in front)
		if ( DebugSelfShadow() > 6.5 && DebugSelfShadow() < 7.5 && hairDbg >= 0.0 )
			out_color.rgb = vec3( hairDbg );
		out_color.a = diffuse.a;

		// emissiveMap: light the surface gives off, after lighting (style passes add only their light); the glow pass
		// (emissiveParams.w 1) sees it alone
		if ( emissive_set > -1 ) {
			const vec3 emissive = stylePass ? vec3( 0.0 ) : texture( emissive_texture, texCoord0 ).rgb * u_global.emissiveParams.rgb;
			out_color.rgb = u_global.emissiveParams.w > 0.5 ? emissive : out_color.rgb + emissive;
		}

		// r_charOcclusionDebug on light-grid lit models: 1 AO, 2 grid light contact, 3 first dynamic light contact,
		// 4 depth reprojection (green: the pixel finds its own depth within 0.05 u, red: off by up to 1 u, blue: none)
		#if defined(USE_LIGHT_VECTOR)
		if ( DebugOcclusion() > 0.5 && !stylePass ) {
			const float dbg = DebugOcclusion();
			if ( dbg < 1.5 )
				out_color.rgb = vec3( screenAO );
			else if ( dbg < 2.5 )
				out_color.rgb = vec3( contactGrid );
			else if ( dbg < 3.5 )
				out_color.rgb = vec3( dbgContactDlight );
			else if ( dbg > 6.5 )
				// 7: the contact masks' channels 1..3 as red, green, blue
				out_color.rgb = ScreenOcclusion().gba;
			else if ( dbg > 5.5 )
				// 6: the raw prepass AO texture, occlusion x8 (white = none)
				out_color.rgb = vec3( 1.0 - 8.0 * ( 1.0 - ScreenAO() ) );
			else if ( dbg > 4.5 ) {
				// 5: projected uv minus the pixel's own uv (x red, y green; 0.5 = equal, x4)
				const vec3 Pv = ( u_camera.viewMatrix * vec4( u_camera.viewOrigin.xyz - var_ViewDir.xyz, 1.0 ) ).xyz;
				const vec2 duv = ScreenUV( Pv ) - gl_FragCoord.xy / vec2( textureSize( screen_depth_texture, 0 ) );
				out_color.rgb = vec3( clamp( duv * 4.0 + 0.5, 0.0, 1.0 ), 0.0 );
			}
			else {
				const vec3 Pv = ( u_camera.viewMatrix * vec4( u_camera.viewOrigin.xyz - var_ViewDir.xyz, 1.0 ) ).xyz;
				const float sd = abs( textureLod( screen_depth_texture, ScreenUV( Pv ), 0.0 ).r );
				const float err = abs( -Pv.z - sd );
				out_color.rgb = sd <= 0.0 ? vec3( 0.0, 0.0, 1.0 ) : err < 0.05 ? vec3( 0.0, 1.0, 0.0 ) : vec3( clamp( err, 0.2, 1.0 ), 0.0, 0.0 );
			}
		}
		#endif

		// r_charShadowDebug 1: the baked light kept under character shadows (style passes add nothing)
		if ( DebugCharShadow() > 0.5 && DebugCharShadow() < 1.5 )
			out_color.rgb = stylePass ? vec3( 0.0 ) : vec3( charKeep * u_camera.charShadowInfo.x );
		else if ( DebugCharShadow() > 2.5 && DebugCharShadow() < 3.5 )
			out_color.rgb = stylePass ? vec3( 0.0 ) : vec3( min( charDbgCover * 0.5, 1.0 ), charDbgOcclusion, 0.0 ) * u_camera.charShadowInfo.x;
		else if ( DebugCharShadow() > 4.5 )
			// 5: the first caster's receiver-to-blocker distance, 128 u = white; blue where no blocker was found
			out_color.rgb = ( stylePass ? vec3( 0.0 ) : charDbgDistance < 0.0 ? vec3( 0.0, 0.0, 1.0 ) : vec3( charDbgDistance / 128.0 ) ) * u_camera.charShadowInfo.x;
		else if ( DebugCharShadow() > 3.5 )
			out_color.rgb = stylePass ? vec3( 0.0 ) : ( charDbgCover > 0.5 ? charDbgStored : vec3( 0.0 ) ) * u_camera.charShadowInfo.x;

		// r_parallaxMapping 2 (normal_texture_set 3): parallax surfaces green, red by the offset's size in texels
		if ( normal_texture_set == 3 )
			out_color.rgb = vec3( clamp( length( parallaxOffset * vec2( textureSize( normal_texture, 0 ) ) ) / 8.0, 0.0, 1.0 ), 0.6, 0.0 );

		// the debug views below show one pass: style passes add nothing to them
		if ( stylePass && DebugSun() > 0.0 )
			out_color.rgb = vec3( 0.0 );

		// r_sunShadowDebug (sunCol.w): 1 = which cascade covers the pixel, 2 = the shadow value
		if ( sunMode != 0 && DebugSun() > 0.0 && u_camera.sunShadowParams.x > 0.0 ) {
			vec4 biasPos = vec4( u_camera.viewOrigin.xyz - var_ViewDir.xyz, 1.0 );
			vec3 c0 = sunShadowCoord( u_camera.sunShadowMvp0, biasPos );
			vec3 c1 = sunShadowCoord( u_camera.sunShadowMvp1, biasPos );
			vec3 c2 = sunShadowCoord( u_camera.sunShadowMvp2, biasPos );
			if ( DebugSun() < 1.5 ) {
				vec3 tint = all( lessThanEqual( abs( c0 - vec3( 0.5 ) ), vec3( 0.5 ) ) ) ? vec3( 1, 0, 0 ) :
					all( lessThanEqual( abs( c1 - vec3( 0.5 ) ), vec3( 0.5 ) ) ) ? vec3( 0, 1, 0 ) :
					all( lessThanEqual( abs( c2 - vec3( 0.5 ) ), vec3( 0.5 ) ) ) ? vec3( 0, 0, 1 ) : vec3( 0.2 );
				out_color.rgb = mix( out_color.rgb, tint, 0.5 );
			} else if ( DebugSun() < 2.5 ) {
				out_color.rgb = vec3( sunShadowValue );
			} else if ( DebugSun() > 4.5 ) {
				const float m = DebugSun();
				out_color.rgb = m < 5.5 ? dbgLight : m < 6.5 ? vec3( clamp( dot( var_Normal.xyz, L ), 0.0, 1.0 ) ) :
					m < 7.5 ? L * 0.5 + 0.5 : m < 8.5 ? diffuse.rgb : m < 9.5 ? dbgAmbient :
					m < 10.5 ? vec3( NL, clamp( dot( N, sunL ), 0.0, 1.0 ), clamp( dot( N, sunL ), 0.0, 1.0 ) ) :
					m < 11.5 ? dbgLightmap : frag_color0.rgb;
			} else if ( DebugSun() > 3.5 ) {
				// 4: cascades not drawn (backend), normal output
			} else {
				// stored depth at the pixel's texel in the first cascade that covers it, bracketed:
				// r/g/b = stored >= 0.1 / 0.4 / 0.7; magenta = no cascade covers the pixel
				const float layer = all( lessThanEqual( abs( c0 - vec3( 0.5 ) ), vec3( 0.5 ) ) ) ? 0.0 :
					all( lessThanEqual( abs( c1 - vec3( 0.5 ) ), vec3( 0.5 ) ) ) ? 1.0 :
					all( lessThanEqual( abs( c2 - vec3( 0.5 ) ), vec3( 0.5 ) ) ) ? 2.0 : -1.0;
				const vec2 st = layer < 0.5 ? c0.xy : layer < 1.5 ? c1.xy : c2.xy;
				out_color.rgb = layer < 0.0 ? vec3( 1.0, 0.0, 1.0 ) : vec3( texture( sun_shadow_texture, vec4( st, layer, 0.1 ) ),
					texture( sun_shadow_texture, vec4( st, layer, 0.4 ) ), texture( sun_shadow_texture, vec4( st, layer, 0.7 ) ) );
			}
		}
		} // existing material models (FMA has its own source Gamma/contrast path)
	#else
		out_color = base;
		if ( color_mode > 0 )
			out_color.rgb *= float( color_mode ) * 0.001;
	#endif

	#if defined(USE_FOG)
		if ( hw_fog == 1 ) {
			int u_fogIndex = int(fogDistanceVector[1]);
			vec4 fog_color = CalcFog( u_camera.viewOrigin.rgb, fog_tex_coord, u_fogs.fogs[u_fogIndex] );
			out_color = mix( out_color, fog_color, fog_color.a );
		} 
		else {
			vec4 fog = texture(fog_texture, fog_tex_coord.xy);
			out_color = mix( out_color, fog * fogColor, fog.a );
		}
	#endif
#endif
}
