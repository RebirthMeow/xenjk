	// depth extract's g (MIN blend), so hair and lashes cast partial contact shadows; without a world position, none
	if ( char_occluder == 2 )
		return;	// depth only
	if ( char_occluder == 1 ) {
	#if defined(PER_PIXEL_LIGHTING)
		out_color = vec4( 1e9, -( u_camera.viewMatrix * vec4( u_camera.viewOrigin.xyz - var_ViewDir.xyz, 1.0 ) ).z, 1e9, 1e9 );
	#else
		out_color = vec4( 1e9 );
	#endif
		return;
	}
	
	#if defined(PER_PIXEL_LIGHTING)
		viewDir = var_ViewDir.xyz;
		E = normalize(viewDir);

		L = var_LightDir.xyz;

		#if defined(USE_LIGHTMAP) && defined(USE_TX1)
			if ( deluxe_mapping > 0 )
				L = ( texture(deluxe_texture, frag_tex_coord1).rgb - vec3(0.5) );
		#endif

		float sqrLightDist = dot(L, L);
		L /= sqrt(sqrLightDist);
		
		#if defined(USE_LIGHTMAP) && defined(USE_TX1)
			vec3 lightmapColor = texture(texture1, frag_tex_coord1).rgb;
			lightColor = lightmapColor * frag_color0.rgb;
			// rend2: the stage colour carries light only (lightColor), the diffuse is the texture
			diffuse = vec4( tex0.rgb, color0.a );
			ambientColor = vec3 (0.0);
			attenuation = 1.0;
		#elif defined(USE_LIGHT_VECTOR)
			lightColor = u_entity.directedLight.rgb;
			ambientColor = u_entity.ambientLight.rgb;
			diffuse = base;
			attenuation = 1.0;
		#elif defined(USE_LIGHT_VERTEX)
			#ifdef USE_CL0_IDENT
				lightColor = vec3(identity_color);
			#else
				lightColor = frag_color0.rgb;
			#endif
			// rend2: the vertex colour is the light (lightColor), the diffuse is the texture
			#if !defined(USE_TX1) && !defined(USE_TX2)
				diffuse = vec4( tex0.rgb, base.a );
			#else
				diffuse = base;
			#endif
			ambientColor = vec3 (0.0);
			attenuation = 1.0;
		#endif

		if ( ( material_mode & 96 ) != 0 ) {
